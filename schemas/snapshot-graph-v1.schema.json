{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://map2.audio/schemas/snapshot-graph-v1.schema.json",
  "title": "MAP2 Snapshot Graph v2026.04",
  "type": "object",
  "required": ["version", "meta", "graph"],
  "additionalProperties": true,
  "properties": {
    "version": {
      "type": "string",
      "const": "2026.04"
    },
    "meta": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "program_number": { "type": "integer" },
        "type": {
          "type": "string",
          "enum": ["snapshot", "template"]
        }
      }
    },
    "graph": {
      "type": "object",
      "required": ["nodes", "edges"],
      "additionalProperties": true,
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "uri", "name", "parameters", "state"],
            "additionalProperties": true,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "uri": {
                "type": "string",
                "pattern": "^(map2:(fx|io|sys|ctrl):[a-z0-9-]+|urn:[A-Za-z0-9][A-Za-z0-9._:-]*|(?!map2:)[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+)$"
              },
              "name": { "type": "string", "minLength": 1 },
              "bypass": { "type": "boolean" },
              "parameters": { "type": "object", "additionalProperties": true },
              "state": { "type": "object", "additionalProperties": true }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "additionalProperties": true,
            "properties": {
              "from": { "type": "string", "minLength": 1 },
              "to": { "type": "string", "minLength": 1 }
            }
          }
        },
        "effects_loops": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "morph": {
          "type": "object",
          "additionalProperties": true,
          "required": ["mode", "position", "source_channel_key", "target_channel_key"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["off", "snapshot", "intra_snapshot", "cross_snapshot"]
            },
            "position": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "source_channel_key": {
              "type": ["string", "null"]
            },
            "target_channel_key": {
              "type": ["string", "null"]
            }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["hash", "name", "path", "size_bytes", "type"],
        "additionalProperties": true,
        "properties": {
          "hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "name": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "type": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
