{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://map2.audio/schemas/snapshot-graph-v1.schema.json",
  "title": "MAP2 Snapshot Graph v2026.06",
  "description": "Monolithic graph document schema for MAP2 State Authority. A snapshot is a single JSONB document that fully describes a rig state: plugins/system-blocks as nodes, port-to-port audio/sidechain edges, parallel/series groups, A-F channels (each with an optional per-chain cluster owner as of v2026.06), routing mode, A/B/C/D quad morph, effects loops, unified control mappings (MIDI/Expression/Maschine/OSC/GPIO), I/O bindings, tempo, output safety, deployment intent, template composition, and (v2026.05+) the optional snapshot-bound `recording` session block consumed by the T2504 Multi-Track Recorder.",
  "type": "object",
  "required": ["version", "meta", "graph"],
  "additionalProperties": true,
  "properties": {
    "version": {
      "type": "string",
      "const": "2026.06"
    },
    "meta": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "program_number": { "type": ["integer", "null"] },
        "type": {
          "type": "string",
          "enum": ["snapshot", "template"]
        },
        "is_favorite": { "type": "boolean" },
        "is_locked": { "type": "boolean" },
        "display_order": { "type": "integer", "minimum": 0 },
        "derived_from_snapshot_id": { "type": ["string", "integer", "null"] },
        "io_bindings": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "input_device": { "type": ["string", "null"] },
            "output_device": { "type": ["string", "null"] },
            "monitoring_output_index": { "type": ["integer", "null"] }
          }
        },
        "community": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "uuid": { "type": ["string", "null"] },
            "shared": { "type": "boolean" },
            "author": { "type": ["string", "null"] },
            "download_count": { "type": "integer", "minimum": 0 },
            "rating_sum": { "type": "number", "minimum": 0.0 },
            "rating_count": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "graph": {
      "type": "object",
      "required": ["nodes", "edges"],
      "additionalProperties": true,
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "uri", "name", "parameters", "state"],
            "additionalProperties": true,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "uri": {
                "type": "string",
                "pattern": "^(map2:(fx|io|sys|ctrl):[a-z0-9-]+|urn:[A-Za-z0-9][A-Za-z0-9._:-]*|(?!map2:)[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+)$"
              },
              "name": { "type": "string", "minLength": 1 },
              "bypass": { "type": "boolean" },
              "parameters": { "type": "object", "additionalProperties": true },
              "state": { "type": "object", "additionalProperties": true }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "additionalProperties": true,
            "properties": {
              "from": { "type": "string", "minLength": 1 },
              "to": { "type": "string", "minLength": 1 },
              "port_kind": {
                "type": "string",
                "enum": ["audio", "sidechain", "control"]
              }
            }
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type", "branches"],
            "additionalProperties": true,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "type": {
                "type": "string",
                "enum": ["parallel", "series"]
              },
              "branches": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              },
              "blend": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
              "master_level": { "type": "number", "minimum": 0.0 },
              "bypass": { "type": "boolean" }
            }
          }
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key"],
            "additionalProperties": true,
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[A-F]$"
              },
              "label": { "type": "string" },
              "color": { "type": "string" },
              "muted": { "type": "boolean" },
              "solo": { "type": "boolean" },
              "dry_wet_mix": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
              "chain_nodes": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "cluster_owner_node_id": {
                "description": "Per-chain cluster owner (v2026.06+). When null, resolves to deployment.primary_node_id at compile/consume time. When a string, must be a non-empty stable cluster node id.",
                "type": ["string", "null"]
              }
            }
          }
        },
        "morph": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["off", "snapshot", "intra_snapshot", "cross_snapshot", "quad"]
            },
            "position": {
              "oneOf": [
                { "type": "number", "minimum": 0.0, "maximum": 1.0 },
                {
                  "type": "object",
                  "required": ["x", "y"],
                  "additionalProperties": true,
                  "properties": {
                    "x": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
                    "y": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
                  }
                }
              ]
            },
            "source_channel_key": { "type": ["string", "null"] },
            "target_channel_key": { "type": ["string", "null"] },
            "source_mode": {
              "type": "string",
              "enum": ["intra", "cross"]
            },
            "endpoints": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "A": { "type": "object", "additionalProperties": true },
                "B": { "type": "object", "additionalProperties": true },
                "C": { "type": "object", "additionalProperties": true },
                "D": { "type": "object", "additionalProperties": true }
              }
            }
          }
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["parallel_blend", "series", "single"]
        },
        "active_channel_key": { "type": ["string", "null"] },
        "blend_positions": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
        },
        "series_order": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "effects_loops": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "send_device": { "type": ["string", "null"] },
          "send_channel": { "type": ["integer", "null"], "minimum": 0 },
          "return_device": { "type": ["string", "null"] },
          "return_channel": { "type": ["integer", "null"], "minimum": 0 },
          "insertions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["after_node", "enabled"],
              "additionalProperties": true,
              "properties": {
                "after_node": { "type": "string", "minLength": 1 },
                "enabled": { "type": "boolean" },
                "mode": {
                  "type": "string",
                  "enum": ["serial_insert", "parallel_send"]
                },
                "blend_pct": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
                "send_gain_db": { "type": "number" },
                "return_gain_db": { "type": "number" },
                "crossfade_ms": { "type": "integer", "minimum": 0, "maximum": 500 }
              }
            }
          }
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "target"],
            "additionalProperties": true,
            "properties": {
              "source": {
                "type": "object",
                "required": ["type"],
                "additionalProperties": true,
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "midi_cc",
                      "midi_pc",
                      "midi_note",
                      "expression",
                      "maschine_encoder",
                      "maschine_pad",
                      "osc",
                      "gpio"
                    ]
                  },
                  "channel": { "type": "integer", "minimum": 1, "maximum": 16 },
                  "cc": { "type": "integer", "minimum": 0, "maximum": 127 },
                  "note": { "type": "integer", "minimum": 0, "maximum": 127 },
                  "program": { "type": "integer", "minimum": 0, "maximum": 127 },
                  "pedal": { "type": "integer", "minimum": 0 },
                  "encoder": { "type": "integer", "minimum": 0 },
                  "pad": { "type": "integer", "minimum": 0 },
                  "path": { "type": "string" },
                  "pin": { "type": "integer", "minimum": 0 },
                  "mode": {
                    "type": "string",
                    "enum": ["momentary", "latching", "toggle"]
                  }
                }
              },
              "target": { "type": "string", "minLength": 1 },
              "range": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "type": "number" }
              },
              "curve": {
                "type": "string",
                "enum": ["linear", "logarithmic", "exponential", "toggle", "stepped"]
              }
            }
          }
        },
        "footswitch_labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "controller_display": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "layout": { "type": "string" },
            "pages": {
              "type": "array",
              "items": { "type": "object", "additionalProperties": true }
            }
          }
        }
      }
    },
    "io": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "input_device": { "type": ["string", "null"] },
        "output_device": { "type": ["string", "null"] },
        "monitoring_output_index": { "type": ["integer", "null"] }
      }
    },
    "tempo": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "bpm": { "type": "number", "minimum": 20.0, "maximum": 300.0 }
      }
    },
    "output_safety": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "reference_dbfs": { "type": "number", "maximum": 0.0 },
        "warning_threshold_db": { "type": "number", "minimum": 0.0 }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "primary_node_id": { "type": ["string", "null"] },
        "standby_node_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "status": {
          "type": "string",
          "enum": ["draft", "staged", "active", "failing", "retired"]
        },
        "strategy": {
          "type": "string",
          "enum": ["manual", "auto", "redundant"]
        },
        "redundancy_enabled": { "type": "boolean" },
        "history": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["timestamp", "action"],
            "additionalProperties": true,
            "properties": {
              "timestamp": { "type": "string" },
              "action": { "type": "string" },
              "node_id": { "type": ["string", "null"] },
              "status": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "templates": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "base": { "type": ["string", "null"] },
        "overlays": {
          "type": "array",
          "items": { "type": "string" }
        },
        "linked": { "type": "boolean" }
      }
    },
    "recording": {
      "description": "Optional snapshot-bound recording session metadata. Consumed by the T2504 Multi-Track Recorder + Playback subsystem. `null` means no recording session is bound to this snapshot. When non-null, the T2507 engine taps install per-chain capture nodes per `tap_matrix`, and the recorder service (T2508) drives lifecycle from `armed`/`rolling`.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["armed", "rolling", "session_id", "started_at", "participating_nodes", "tap_matrix"],
          "additionalProperties": true,
          "properties": {
            "session_id": { "type": ["string", "null"] },
            "armed": { "type": "boolean" },
            "rolling": { "type": "boolean" },
            "started_at": { "type": ["string", "null"] },
            "participating_nodes": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "tap_matrix": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["pre_fx", "post_fx"],
                "additionalProperties": true,
                "properties": {
                  "pre_fx": { "type": "boolean" },
                  "post_fx": { "type": "boolean" }
                }
              }
            }
          }
        }
      ]
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["hash", "name", "path", "size_bytes", "type"],
        "additionalProperties": true,
        "properties": {
          "hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "name": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "type": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
