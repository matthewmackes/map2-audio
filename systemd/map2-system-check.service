[Unit]
Description=MAP2 Audio Platform System Check and Auto-Start
After=network.target sound.target
Wants=network.target

[Service]
Type=oneshot
User=mm
Group=mm
WorkingDirectory=/home/mm/map2-audio
Environment="PYTHONPATH=/home/mm/map2-audio"
Environment="PATH=/usr/local/bin:/usr/bin:/bin:/home/mm/.local/bin"
ExecStart=/bin/bash /home/mm/map2-audio/map2-system-check.sh
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
