[Unit]
Description=MAP2 Audio Platform Backend API
Documentation=https://github.com/matthewmackes/map2-audio
After=network.target sound.target map2-boot-manager.service
Wants=sound.target map2-boot-manager.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=mm
Group=mm
WorkingDirectory=/home/mm/map2-audio
Environment="PYTHONPATH=/home/mm/map2-audio"
Environment="PATH=/usr/local/bin:/usr/bin:/bin:/home/mm/.local/bin"
Environment="MAP2_ENABLE_LCD=false"
Environment="MAP2_LCD_SIMULATION=false"
Environment="XDG_RUNTIME_DIR=/run/user/1000"
Environment="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus"
Environment="PIPEWIRE_REMOTE=pipewire-0"
Environment="JACK_DEFAULT_SERVER=pipewire"
EnvironmentFile=-/etc/map2/environment

# PipeWire configuration for low-latency audio
Environment="PIPEWIRE_LATENCY=64/48000"
Environment="PIPEWIRE_FALLBACK_PLAYBACK_DEVICE=alsa_output.usb-EDIROL_UA-1000_ZS22041-02.multichannel-output"
Environment="PIPEWIRE_FALLBACK_CAPTURE_DEVICE=alsa_input.usb-EDIROL_UA-1000_ZS22041-02.multichannel-input"

# Force PipeWire graph quantum/rate in the user session via pw-metadata.
# These must be set here (not in pipewire.conf.d/) because:
#   1. clock.force-* values in .conf files cannot be overridden by applications
#      at runtime — they are locked at PipeWire load time.
#   2. pw-metadata settings survive a JACK client restart within the same session
#      but reset on PipeWire daemon restart, so re-applying at service start is correct.
#
# ORDER IS CRITICAL: force-rate resets quantum internally in PipeWire. Setting
# rate first, then quantum, guarantees quantum=64 is the final active value.
# Do NOT swap these lines or add a second force-quantum after this block.
# REMARK: Profile-driven deployments may override this block via:
#   /etc/systemd/system/map2-backend.service.d/20-clock-sync-profile.conf
# generated by scripts/apply_clock_sync_profile.py.
ExecStartPre=/usr/bin/pw-metadata -n settings 0 clock.force-rate 48000
ExecStartPre=/usr/bin/pw-metadata -n settings 0 clock.force-quantum 64

# Start the unified orchestrator via FastAPI
ExecStart=/usr/bin/python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8080 --no-access-log

# Graceful shutdown - orchestrator handles service shutdown sequence
ExecStop=/bin/kill -TERM $MAINPID
TimeoutStopSec=30
TimeoutStartSec=120

# Readiness validation - check API is responsive (not full service readiness)
# /api/health returns 200 when FastAPI is up; /api/ready requires all services
# Use /api/health here so systemd doesn't kill us while services are still initializing
ExecStartPost=/bin/bash -c 'for i in $(seq 1 30); do curl -sf http://localhost:8080/api/health > /dev/null && exit 0; sleep 2; done; exit 1'

Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=map2-orchestrator

# ── Realtime audio scheduling model ──────────────────────────────────────────
# This service runs uvicorn (Python async HTTP server) that hosts the JUCE
# audio engine as a native extension. The RT scheduling hierarchy is:
#
#   Python/uvicorn event loop  → Nice=-10, SCHED_OTHER  (I/O bound, not RT)
#   JUCE audio callback thread → SCHED_FIFO 80 (self-elevated by JUCE framework
#                                 via pthread_setschedparam on audio device open)
#
# INTENTIONAL: CPUSchedulingPolicy is NOT set to fifo here. Setting the entire
# uvicorn process to SCHED_FIFO would place the async HTTP event loop, WebSocket
# handlers, and FastAPI workers into the RT scheduler, causing starvation of kernel
# threads and non-RT system processes. Only the JUCE audio callback thread needs RT.
# That thread self-elevates using CAP_SYS_NICE (AmbientCapabilities below) +
# LimitRTPRIO=95 (grants rtprio to all threads in this process).
#
# To verify JUCE audio thread has RT scheduling after startup:
#   ps -eLo pid,comm,cls,rtprio | grep -E "pipewire|wire|python|uvicorn"
#   Expected: JUCE audio callback thread shows CLS=FF (FIFO), RTPRIO=80

Nice=-10
LimitRTPRIO=95
LimitMEMLOCK=infinity
LimitNOFILE=65536

# CPU affinity: pin to kernel-isolated cores (set in GRUB via isolcpus=4,5).
# nohz_full=4,5 and rcu_nocbs=4,5 are also set in GRUB for these cores,
# eliminating HZ tick interrupts and RCU callbacks on the audio cores.
# IMPORTANT: Must match GRUB_CMDLINE_LINUX isolcpus= value. Previously mismatched
# (GRUB had isolcpus=2,3 while this was CPUAffinity=4 5) — now both use 4,5.
CPUAffinity=4 5

# I/O priority - realtime class, high priority
IOSchedulingClass=realtime
IOSchedulingPriority=1

# Allow RT scheduling for the JUCE audio callback thread.
# CAP_SYS_NICE: permits pthread_setschedparam(SCHED_FIFO) without root.
# AmbientCapabilities: the capability is inherited by child threads (audio thread).
AmbientCapabilities=CAP_SYS_NICE
CapabilityBoundingSet=CAP_SYS_NICE

# Security hardening (NoNewPrivileges removed - RT scheduling via RTKit requires new privileges)
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/mm/map2-audio/logs /home/mm/map2-audio/data /home/mm/.map2 /home/mm/.config/pipewire /home/mm/.local/share /home/mm/.cache /tmp /etc/map2 /run/map2-audio

[Install]
WantedBy=multi-user.target
