[Unit]
Description=MAP2 Audio Platform - Production Web Server (Port 3000)
Documentation=https://github.com/matthewmackes/map2-audio
After=network.target map2-backend.service
Wants=map2-backend.service

[Service]
Type=simple
User=mm
Group=mm
WorkingDirectory=/home/mm/map2-audio/web
Environment="PATH=/usr/local/bin:/usr/bin:/bin:/home/mm/.local/bin"
Environment="NODE_ENV=production"

# Serve pre-built dist/ via the dedicated production web server on port 3000.
ExecStart=/usr/bin/npm run serve

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=map2-web-prod

# Resource limits
LimitNOFILE=65536

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
