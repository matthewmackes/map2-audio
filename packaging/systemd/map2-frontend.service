[Unit]
# T2529-A3 — packaging-tree frontend static server. Serves /opt/map2-audio/web/dist
# on port 3000. Runs under the dedicated `map2` system service user.
Description=MAP2 Audio Platform - Frontend Web Service
Documentation=https://github.com/matthewmackes/map2-audio
Documentation=file:///opt/map2-audio/docs/install/SERVICE_USER.md
After=map2-backend.service
Wants=map2-backend.service

[Service]
Type=simple
User=map2
Group=map2
WorkingDirectory=/opt/map2-audio/web
EnvironmentFile=-/etc/map2/environment
EnvironmentFile=-/etc/map2/environment.d/*.env
ExecStart=/usr/bin/python3 -m http.server --directory /opt/map2-audio/web/dist 3000
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=map2-frontend

# T2529-B1 — full sandbox model. Frontend is a static HTTP server,
# the tightest sandbox of any unit.
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/log/map2

# Resource limits
LimitNOFILE=65536
LimitNPROC=32768
MemoryMax=1G

[Install]
WantedBy=multi-user.target
