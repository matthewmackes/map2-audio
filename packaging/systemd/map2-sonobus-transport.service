[Unit]
# T2529-A3 — packaging-tree SonoBus/AOO transport daemon. Runs under the
# dedicated `map2` system service user against /opt/map2-audio. Replaces
# the operator-home (/home/mm/...) path that was scaffolded during T2521-8.
Description=MAP2 SonoBus / AOO remote-audio transport daemon
Documentation=https://github.com/matthewmackes/map2-audio
Documentation=file:///opt/map2-audio/docs/architecture/SONOBUS_AOO_TRANSPORT.md
Documentation=file:///opt/map2-audio/docs/install/SERVICE_USER.md
# T2521-8 — service unit scaffolding shipped ahead of the T2521-4 daemon
# binary. Per the locked Q15 decision the daemon is installed and enabled
# by default; until T2521-4 lands `map2-sonobus-transport`, the unit will
# fail to start (ExecStart binary missing) and is therefore masked-by-
# presence rather than actually running. The systemd entry exists now so
# installer + RPM + firewall coverage can land in this slice.
#
# Order: starts AFTER sound.target so JACK/PipeWire are available for the
# daemon's port handoff. Stays off the isolated audio cores (4,5) — the
# AOO source/sink runtime is non-RT.
After=network.target sound.target
Wants=sound.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=map2
Group=map2

# Audio + JACK access for the AOO source/sink JACK client. Same group set
# as map2-backend.service.
SupplementaryGroups=audio pipewire pipewire-system

WorkingDirectory=/opt/map2-audio
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=/opt/map2-audio"

# T2529-A5: per-service runtime dir + system-wide PipeWire socket.
Environment="XDG_RUNTIME_DIR=/run/map2"
Environment="PIPEWIRE_REMOTE=/run/pipewire-system/pipewire-0"
Environment="JACK_DEFAULT_SERVER=pipewire"

# Q3 — MAP2 hosts its own AOO/SonoBus connection server by default.
# Operator can disable in /etc/map2/environment by setting
# MAP2_SONOBUS_CONNECTION_SERVER=0.
Environment="MAP2_SONOBUS_CONNECTION_SERVER=1"

# Q14 — full multichannel from day one. The daemon caps per-binding
# channel_count at 32 by default; this env var is the system-wide cap
# the schema layer reads on startup.
Environment="MAP2_SONOBUS_MAX_CHANNELS=32"

# Q18 — default transport priority. The authority's per-binding default
# reads from here.
Environment="MAP2_SONOBUS_DEFAULT_TRANSPORT_PRIORITY=avb_preferred"

# Default UDP port range (10000-10100). Firewalld zone fragment
# `map2-sonobus.xml` opens the same range.
Environment="MAP2_SONOBUS_UDP_PORT_BASE=10000"
Environment="MAP2_SONOBUS_UDP_PORT_COUNT=100"

EnvironmentFile=-/etc/map2/environment
EnvironmentFile=-/etc/map2/environment.d/*.env
EnvironmentFile=-/etc/map2/sonobus.env

# T2521-8 — placeholder ExecStart. The actual binary is delivered by
# T2521-4 and will land at /opt/map2-audio/juce-engine/build/. systemctl
# will fail-to-start until then, which is the intended state.
ExecStart=/opt/map2-audio/juce-engine/build/map2-sonobus-transport \
  --socket /run/map2/sonobus-transport.sock \
  --port-base ${MAP2_SONOBUS_UDP_PORT_BASE} \
  --port-count ${MAP2_SONOBUS_UDP_PORT_COUNT}

# Graceful shutdown.
ExecStop=/bin/kill -TERM $MAINPID
TimeoutStopSec=15
TimeoutStartSec=30

Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=map2-sonobus-transport

# Modest RT eligibility for the AOO send/receive thread (below
# audio-callback at 80, below libremidi I/O at 70). Network jitter
# absorption is the daemon's primary job; SCHED_FIFO/40 is enough.
LimitRTPRIO=40
LimitMEMLOCK=infinity
LimitNOFILE=65536

# CPU affinity: stay off the isolated audio cores (4,5). The AOO
# source/sink runtime is non-RT — JACK absorbs the audio handoff via
# the lock-free port queue.
CPUAffinity=0 1 2 3

AmbientCapabilities=CAP_SYS_NICE CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_SYS_NICE CAP_NET_BIND_SERVICE

# T2529-B3 — seccomp allowlist. The AOO source/sink uses JACK MIDI ports
# for the audio handoff (covered by @audio) and UDP sockets for transport
# (covered by @system-service).
SystemCallFilter=@system-service @audio @resources
SystemCallFilter=~@clock @cpu-emulation @debug @module @mount @obsolete @privileged @raw-io @reboot @swap
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

# UDS socket cleanup — same pattern as map2-controller-host. systemd-tmpfiles
# is authoritative; this mkdir/chmod pair keeps the unit self-contained
# on hosts where tmpfiles hasn't yet run.
ExecStartPre=/bin/mkdir -p /run/map2
ExecStartPre=/bin/chmod 0755 /run/map2

# T2529-B1 — full sandbox model.
ProtectSystem=strict
ReadWritePaths=/run/map2 /var/log/map2
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
# AOO send/receive thread needs SCHED_FIFO
RestrictRealtime=false
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
