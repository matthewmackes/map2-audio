[Unit]
# T2529-A3 — packaging-tree TUI console. Runs under the dedicated `map2`
# system service user from /opt/map2-audio (FHS §3.13 — application tree).
Description=MAP2 Audio Platform TUI Console
Documentation=https://github.com/matthewmackes/map2-audio
Documentation=file:///opt/map2-audio/docs/install/SERVICE_USER.md
After=network.target map2-backend.service
Requires=map2-backend.service

[Service]
Type=simple
User=map2
Group=map2
SupplementaryGroups=audio

WorkingDirectory=/opt/map2-audio
Environment="PYTHONPATH=/opt/map2-audio"
Environment="XDG_RUNTIME_DIR=/run/map2"
EnvironmentFile=-/etc/map2/environment
EnvironmentFile=-/etc/map2/environment.d/*.env

ExecStart=/usr/bin/python3 -m tui.app
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=map2-tui

# T2529-B1 — full sandbox model. TUI is the most restrictive: it talks
# to the backend only via HTTP/WS to localhost:8080, so the network
# allowlist can drop AF_NETLINK / AF_PACKET entirely.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/run/map2 /var/log/map2

[Install]
WantedBy=multi-user.target
