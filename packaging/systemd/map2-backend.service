[Unit]
Description=MAP2 Audio Backend
After=network.target

[Service]
Type=simple
User=map2
WorkingDirectory=/usr/lib/map2
Environment="XDG_RUNTIME_DIR=/run/user/1000"
Environment="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus"
Environment="PIPEWIRE_REMOTE=pipewire-0"
Environment="JACK_DEFAULT_SERVER=pipewire"
ExecStartPre=/usr/bin/pw-metadata -n settings 0 clock.force-quantum 128
ExecStartPre=/usr/bin/pw-metadata -n settings 0 clock.force-rate 48000
Environment="PIPEWIRE_LATENCY=128/48000"
ExecStart=/usr/bin/python3 -m uvicorn app.main:create_app --factory --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
