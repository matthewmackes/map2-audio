[Unit]
Description=MAP2 Audio Backend
After=network.target

[Service]
Type=simple
User=map2
WorkingDirectory=/opt/map2
Environment="PYTHONPATH=/opt/map2:/opt/map2/juce-engine/build"
Environment="XDG_RUNTIME_DIR=/run/user/1000"
Environment="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus"
Environment="PIPEWIRE_REMOTE=pipewire-0"
Environment="JACK_DEFAULT_SERVER=pipewire"
# ORDER REMARK: PipeWire resets quantum when force-rate changes.
# Always apply rate first, then quantum.
ExecStartPre=/usr/bin/pw-metadata -n settings 0 clock.force-rate 48000
ExecStartPre=/usr/bin/pw-metadata -n settings 0 clock.force-quantum 128
Environment="PIPEWIRE_LATENCY=128/48000"
ExecStart=/usr/bin/python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8080 --no-access-log
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
