[Unit]
# T2529-A3 — Prometheus server for the MAP2 platform.
# T2529-B1 — full sandbox model.
Description=MAP2 Prometheus Server
Documentation=https://github.com/matthewmackes/map2-audio
Documentation=file:///opt/map2-audio/docs/install/FHS_LAYOUT.md
After=network-online.target map2-backend.service
Wants=network-online.target

[Service]
Type=simple
User=map2
Group=map2
ExecStart=/usr/bin/prometheus \
  --config.file=/etc/map2/prometheus/prometheus.yml \
  --storage.tsdb.path=/var/lib/map2/prometheus \
  --storage.tsdb.retention.time=15d \
  --web.listen-address=127.0.0.1:9090 \
  --web.enable-lifecycle
Restart=on-failure
RestartSec=5
StateDirectory=map2/prometheus

# T2529-B2 — capability bounding set. Binds 127.0.0.1:9090 (unprivileged),
# no caps needed.
CapabilityBoundingSet=
AmbientCapabilities=

# T2529-B3 — seccomp allowlist. Prometheus is a Go binary; @system-service
# covers epoll, scrape HTTP, TSDB writes.
SystemCallFilter=@system-service
SystemCallFilter=~@clock @cpu-emulation @debug @module @mount @obsolete @privileged @raw-io @reboot @resources @swap
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

# T2529-B1 — full sandbox model.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/map2/prometheus /var/log/map2

[Install]
WantedBy=multi-user.target
