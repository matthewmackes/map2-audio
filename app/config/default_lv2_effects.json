    {
      "name": "TooB CE-2 Chorus",
      "uri": "http://two-play.com/plugins/toob-ce2-chorus",
      "category": "Chorus",
      "description": "Boss CE-2 style chorus - warm analog modulation",
      "audio_ports": {
        "inputs": 2,
        "outputs": 2
      },
      "priority": 10,
      "is_hard_rt_capable": true
    },
    {
      "name": "TooB BF-2 Flanger",
      "uri": "http://two-play.com/plugins/toob-bf2-flanger",
