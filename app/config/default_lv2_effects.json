      "audio_ports": {
        "inputs": 2,
        "outputs": 2
      },
      "priority": 10,
      "is_hard_rt_capable": true
    },
    {
      "name": "TooB Phaser",
      "uri": "http://two-play.com/plugins/toob-phaser",
