<svg viewBox="0 0 300 400" xmlns="http://www.w3.org/2000/svg">
  <!-- Lenovo ThinkCentre SFF placeholder -->
  <defs>
    <linearGradient id="metalGrad2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#e5e7eb;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#d1d5db;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#9ca3af;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Case body -->
  <rect x="45" y="80" width="210" height="240" rx="8" fill="url(#metalGrad2)" stroke="#6b7280" stroke-width="2"/>
  
  <!-- Front panel -->
  <rect x="55" y="100" width="190" height="200" rx="4" fill="#0a0e27" stroke="#4b5563" stroke-width="1"/>
  
  <!-- Lenovo logo area -->
  <text x="150" y="135" font-family="Arial" font-size="16" font-weight="bold" fill="#E4001B" text-anchor="middle">⊞</text>
  
  <!-- Drive bays -->
  <rect x="70" y="160" width="160" height="15" rx="2" fill="#374151" stroke="#4b5563" stroke-width="1"/>
  <rect x="70" y="185" width="160" height="15" rx="2" fill="#374151" stroke="#4b5563" stroke-width="1"/>
  
  <!-- Power button -->
  <circle cx="80" cy="260" r="8" fill="#E4001B" stroke="#4b5563" stroke-width="1"/>
  
  <!-- Standoff feet -->
  <rect x="60" y="320" width="12" height="6" fill="#6b7280"/>
  <rect x="228" y="320" width="12" height="6" fill="#6b7280"/>
  
  <!-- Label -->
  <text x="150" y="360" font-family="Arial" font-size="12" font-weight="bold" fill="#4b5563" text-anchor="middle">ThinkCentre SFF</text>
</svg>
