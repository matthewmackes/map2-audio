<svg viewBox="0 0 300 400" xmlns="http://www.w3.org/2000/svg">
  <!-- Dell OptiPlex SFF placeholder -->
  <defs>
    <linearGradient id="metalGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#e5e7eb;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#d1d5db;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#9ca3af;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Case body -->
  <rect x="50" y="80" width="200" height="240" rx="8" fill="url(#metalGrad)" stroke="#6b7280" stroke-width="2"/>
  
  <!-- Front panel -->
  <rect x="60" y="100" width="180" height="200" rx="4" fill="#1f2937" stroke="#4b5563" stroke-width="1"/>
  
  <!-- Dell logo area -->
  <circle cx="150" cy="130" r="15" fill="#0066CC" opacity="0.8"/>
  <text x="150" y="135" font-family="Arial" font-size="14" font-weight="bold" fill="white" text-anchor="middle">D</text>
  
  <!-- Drive bays -->
  <rect x="75" y="160" width="150" height="15" rx="2" fill="#374151" stroke="#4b5563" stroke-width="1"/>
  <rect x="75" y="185" width="150" height="15" rx="2" fill="#374151" stroke="#4b5563" stroke-width="1"/>
  
  <!-- Power button -->
  <circle cx="85" cy="260" r="8" fill="#0066CC" stroke="#4b5563" stroke-width="1"/>
  
  <!-- Standoff feet -->
  <rect x="65" y="320" width="12" height="6" fill="#6b7280"/>
  <rect x="223" y="320" width="12" height="6" fill="#6b7280"/>
  
  <!-- Label -->
  <text x="150" y="360" font-family="Arial" font-size="12" font-weight="bold" fill="#4b5563" text-anchor="middle">OptiPlex SFF</text>
</svg>
