{
  "name": "mackes-audio-platform-2-web",
  "private": true,
  "version": "3.0.0-FEB2026",
  "description": "Mackes Audio Platform 3.0 FEB2026 (Multinode) - Professional Guitar Effects Processor Web Interface with Cluster Management",
  "type": "module",
  "scripts": {
    "_comment_ports": "IMPORTANT: Port 3000 = PRODUCTION (serves dist/), Port 3001 = DEVELOPMENT (vite dev server with HMR). Do NOT confuse these!",
    "dev": "vite --host 0.0.0.0 --port 3001",
    "build": "tsc -b && vite build",
    "deploy": "../scripts/build/deploy",
    "deploy:restart": "../scripts/build/deploy --skip-build",
    "deploy:status": "../scripts/build/deploy --status",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "serve": "npx serve dist -l 3000 --no-clipboard -s",
    "start:prod": "npm run build && npm run serve",
    "start:dev": "npm run dev",
    "start:all": "npm run build && concurrently \"npm run serve\" \"npm run dev\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ariakit/react": "^0.4.21",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.1.1",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "@mui/styles": "^6.4.4",
    "@phosphor-icons/react": "^2.1.10",
    "@react-hook/window-size": "^3.1.1",
    "@reactflow/controls": "^11.2.14",
    "@reactflow/minimap": "^11.7.14",
    "@reactflow/node-resizer": "^2.2.14",
    "@tanstack/react-query": "^5.59.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "framer-motion": "^12.34.0",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.0",
    "react-markdown": "^10.1.0",
    "react-remark": "^2.1.0",
    "react-router-dom": "^6.28.0",
    "react-virtualized-auto-sizer": "^1.0.25",
    "react-window": "^1.8.11",
    "reactflow": "^11.11.4",
    "recharts": "^3.7.0",
    "rehype-external-links": "^3.0.0",
    "tss-react": "^4.9.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@tanstack/react-query-devtools": "^5.59.0",
    "@types/dagre": "^0.7.53",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.14.0",
    "serve": "^14.2.5",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.4.1",
    "vite-plugin-svgr": "^4.3.0"
  },
  "author": "Mackes Audio Platform 2 (based on PiPedal by Robin Davies)",
  "license": "MIT"
}
