{
  "name": "mackes-audio-platform-2-web",
  "private": true,
  "version": "3.0.0-FEB2026",
  "description": "Mackes Audio Platform 3.0 FEB2026 (Multinode) - Professional Guitar Effects Processor Web Interface with Cluster Management",
  "type": "module",
  "scripts": {
    "prebuild": "python3 ../scripts/generate_platform_version.py",
    "build": "python3 ../scripts/build_web_dist_atomic.py",
    "deploy": "../scripts/build/deploy",
    "deploy:restart": "../scripts/build/deploy --skip-build",
    "deploy:status": "../scripts/build/deploy --status",
    "lint": "eslint .",
    "preview": "node ../scripts/serve_web_dist.mjs --host 0.0.0.0 --port 3000",
    "serve": "node ../scripts/serve_web_dist.mjs --host 0.0.0.0 --port 3000",
    "start:prod": "npm run build && npm run serve",
    "typecheck": "tsc --noEmit",
    "test": "node ../node_modules/jest/bin/jest.js --config ../package.json",
    "version:sync": "python3 ../scripts/generate_platform_version.py",
    "visual:home-smoke": "node ../scripts/run_home_visual_smoke.mjs",
    "visual:home-smoke:install": "playwright install chromium",
    "visual:workspace-smoke": "node ../scripts/run_workspace_visual_smoke.mjs",
    "visual:workspace-smoke:install": "playwright install chromium"
  },
  "dependencies": {
    "@ariakit/react": "^0.4.21",
    "@carbon/icons-react": "^11.76.0",
    "@carbon/react": "^1.103.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@faker-js/faker": "^10.4.0",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/fira-sans": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/lato": "^5.2.7",
    "@fontsource/montserrat": "^5.2.8",
    "@fontsource/open-sans": "^5.2.7",
    "@fontsource/poppins": "^5.2.7",
    "@fontsource/roboto": "^5.1.1",
    "@fontsource/source-sans-3": "^5.2.9",
    "@fontsource/space-grotesk": "^5.2.10",
    "@fontsource/work-sans": "^5.2.8",
    "@monaco-editor/react": "^4.7.0",
    "@mui/material": "^6.5.0",
    "@tanstack/react-query": "^5.59.0",
    "dagre": "^0.8.5",
    "framer-motion": "^12.34.0",
    "history": "^5.3.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.28.0",
    "react-toastify": "^10.0.6",
    "react-virtualized-auto-sizer": "^1.0.25",
    "react-window": "^1.8.11",
    "reactflow": "^11.11.4",
    "recharts": "^3.7.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@tanstack/react-query-devtools": "^5.59.0",
    "@types/dagre": "^0.7.53",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.14.0",
    "playwright": "^1.55.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.4.1",
    "vite-plugin-svgr": "^4.3.0"
  },
  "author": "Mackes Audio Platform 2 (based on PiPedal by Robin Davies)",
