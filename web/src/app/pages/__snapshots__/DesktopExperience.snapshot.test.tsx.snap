          </button>
          <button
            class="cds--btn cds--btn--primary"
            type="button"
          >
            Confirm restart
          </button>
        </div>
      </div>
      <button
        class="cds--visually-hidden"
        type="button"
      >
        Focus sentinel
      </button>
    </div>
  </div>
</div>
`;

