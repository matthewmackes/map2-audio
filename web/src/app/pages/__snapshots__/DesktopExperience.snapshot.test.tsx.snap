      <div
        class="hp2-root hp2-root--landing hp2-root--minimal"
        data-reduced-effects="false"
        data-testid="home-shell"
        data-wallpaper-mode="minimal"
      >
        <div
          aria-hidden="true"
          class="hp2-root__backdrop"
        />
        <main
          class="cds--content hp2-home-shell__content"
        >
          <div
            class="hp2-home-shell__grid cds--css-grid cds--css-grid--condensed"
          >
            <div
              class="cds--sm:col-span-4 cds--md:col-span-8 cds--lg:col-span-16 cds--css-grid-column"
            >
              <section
                aria-label="MAP2 home telemetry"
                class="hp2-home-shell__operations-shell"
              >
                <section
                  aria-label="MAP2 welcome hero"
                  class="wh-shell"
                  data-testid="welcome-hero"
                >
                  <div
                    class="wh-topbar"
                  >
                    <div
                      class="wh-topbar__left"
                    >
                      <span
                        aria-hidden="true"
                        class="wh-topbar__dot"
                      />
                      <span>
                        MAP2 · Live Operations Surface
                      </span>
                      <span
                        aria-hidden="true"
                        class="wh-topbar__sep"
                      >
                        ·
                      </span>
                      <span>
                        node · 
                        local
                      </span>
                    </div>
                    <div
                      class="wh-topbar__right"
                    >
                      <span>
                        v 
                        <b>
                          2026.4.2
                        </b>
                      </span>
                      <span>
                        sr 
                        <b>
                          96 kHz
                        </b>
                      </span>
                      <span>
                        buf 
                        <b>
                          64 / 0.67 ms
                        </b>
                      </span>
                      <span>
                        cpu 
                        <b>
                          —
                        </b>
                      </span>
                    </div>
                  </div>
                  <div
                    class="wh-hero"
                  >
                    <div
                      aria-hidden="true"
                      class="wh-hero__grid"
                    />
                    <div
                      aria-hidden="true"
                      class="wh-hero__glow"
                    />
                    <div
                      aria-hidden="true"
                      class="wh-hero__wordmark"
                    >
                      <img
                        alt=""
                        src="MAP2-LOGO.png"
                      />
                    </div>
                    <div
                      class="wh-hero__content"
                    >
                      <div
                        class="wh-hero__eyebrow"
                      >
                        WELCOME TO MAP2 · MACKES AUDIO PLATFORM
                      </div>
                      <h1
                        class="wh-hero__title"
                      >
                        <span>
                          System nominal.
                        </span>
                         
                        <span
                          class="wh-accent"
                        >
                          Welcome to MAP2.
                        </span>
                      </h1>
                      <p
                        class="wh-hero__lede"
                      >
                        Your studio is warmed up and every device is reporting in.
                         
                        <b>
                          0
                        </b>
                         artifacts are loaded in the library,
                         
                        <b>
                          0
                           MIDI 
                          controllers
                        </b>
                         
                        and
                         
                        <b>
                          0
                           audio 
                          interfaces
                        </b>
                         
                        are live on the bus, and the routing matrix is holding steady at sub‑millisecond latency. Pick up where you left off, or start something new — the whole rig is yours.
                      </p>
                      <div
                        class="wh-hero__cta-row"
                      >
                        <button
                          class="wh-btn wh-btn--primary"
                          data-testid="welcome-hero-cta-enter"
                          type="button"
                        >
                          Enter Live Surface 
                          <svg
                            aria-hidden="true"
                            fill="none"
                            stroke="currentColor"
                            stroke-linecap="square"
                            stroke-width="1.6"
                            viewBox="0 0 24 24"
                          >
                            <path
                              d="M5 12h14"
                            />
                            <path
                              d="M13 6l6 6-6 6"
                            />
                          </svg>
                        </button>
                        <button
                          class="wh-btn wh-btn--ghost"
                          data-testid="welcome-hero-cta-library"
                          type="button"
                        >
                          Browse Library 
                          <svg
                            aria-hidden="true"
                            fill="none"
                            stroke="currentColor"
                            stroke-linecap="square"
                            stroke-width="1.6"
                            viewBox="0 0 24 24"
                          >
                            <path
                              d="M4 4h10a4 4 0 014 4v12H8a4 4 0 01-4-4V4z"
                            />
                            <path
                              d="M4 4v12a4 4 0 004 4"
                            />
                          </svg>
                        </button>
                      </div>
                      <div
                        class="wh-hero__session"
                      >
                        <div>
                          <label>
                            Last Session
                          </label>
                          <strong>
                            No live snapshot
                          </strong>
                        </div>
                        <div>
                          <label>
                            Open Patch
                          </label>
                          <strong>
                            0 nodes online
                          </strong>
                        </div>
                        <div>
                          <label>
                            Uptime
                          </label>
                          <strong>
                            live
                          </strong>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div
                    class="wh-stats"
                  >
                    <section
                      aria-label="Artifact library"
                      class="wh-panel"
                    >
                      <header
                        class="wh-panel__head"
                      >
                        <h2
                          class="wh-panel__title"
                        >
                          Artifact Library · 
                          0
                           total
                        </h2>
                        <div
                          class="wh-panel__kicker"
                        >
                          <b>
                            ● indexed
                          </b>
                           · 
                          last scan just now
                        </div>
                      </header>
                      <div
                        class="wh-artifacts"
                      >
                        <button
                          class="wh-artifact"
                          data-artifact="presets"
                          style="--wh-accent: var(--wh-primary);"
                          type="button"
                        >
                          <div
                            class="wh-artifact__count"
                          >
                            0
                          </div>
                          <div
                            class="wh-artifact__label"
                          >
                            Presets
                          </div>
                          <div
                            class="wh-artifact__sub"
                          >
