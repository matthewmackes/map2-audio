    <main
      class="app-content app-content--with-global-tree"
    >
      <header
        class="shell-kicker"
      >
        <div
          class="shell-kicker__head"
        >
          <div
            class="shell-kicker__copy"
          >
            <nav
              aria-label="Workspace breadcrumbs"
              class="shell-kicker__breadcrumbs"
            >
              <span
                class="shell-kicker__breadcrumb-item"
              >
                <span
                  class="shell-kicker__breadcrumb-host-label"
                >
                  MAP2-TESTBED
                </span>
                <span
                  class="shell-kicker__breadcrumb-sep"
                >
                  /
                </span>
              </span>
              <span
                class="shell-kicker__breadcrumb-item"
              >
