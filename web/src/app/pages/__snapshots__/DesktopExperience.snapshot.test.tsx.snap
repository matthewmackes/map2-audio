exports[`Desktop experience visual snapshots matches the desktop shell after boot completes 1`] = `
<div
  class="app-shell app-shell--windowed app-shell--landing"
  style="--window-shell-accent: var(--cds-support-warning); --global-tree-width: 16rem; --global-tree-banner-left-offset: 16rem;"
>
  <div
    class="app-shell__frame"
