          >
            Restart backend
          </h2>
          <div
            class="cds--modal-close-button"
          >
            <span
              class="cds--popover-container cds--popover--caret cds--popover--high-contrast cds--popover--left cds--tooltip cds--icon-tooltip"
            >
              <div
                class="cds--tooltip-trigger__wrapper"
              >
                <button
                  aria-label="Close"
                  aria-labelledby="tooltip-_r_2f_"
                  class="cds--modal-close cds--btn cds--btn--primary cds--btn--icon-only"
                  type="button"
                >
                  <svg
                    aria-hidden="true"
                    class="cds--modal-close__icon"
                    fill="currentColor"
                    focusable="false"
                    height="20"
                    preserveAspectRatio="xMidYMid meet"
                    viewBox="0 0 32 32"
                    width="20"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M17.4141 16 24 9.4141 22.5859 8 16 14.5859 9.4143 8 8 9.4141 14.5859 16 8 22.5859 9.4143 24 16 17.4141 22.5859 24 24 22.5859 17.4141 16z"
                    />
                  </svg>
                </button>
              </div>
              <span
                aria-hidden="true"
                class="cds--popover"
                id="tooltip-_r_2f_"
                role="tooltip"
              >
                <span
                  class="cds--popover-content cds--tooltip-content"
                >
                  Close
                </span>
                <span
                  class="cds--popover-caret"
                />
              </span>
            </span>
          </div>
        </div>
        <div
          class="cds--layer-two cds--modal-content cds--modal-scroll-content--no-fade"
        >
          Restart the MAP2 backend service? Audio processing will pause briefly while the shell reconnects.
        </div>
        <div
          aria-busy="false"
          class="cds--modal-footer cds--btn-set"
        >
          <button
            class="cds--btn cds--btn--secondary"
            type="button"
          >
            Cancel
          </button>
          <button
            class="cds--btn cds--btn--primary"
            type="button"
          >
            Confirm restart
          </button>
        </div>
      </div>
      <button
        class="cds--visually-hidden"
        type="button"
      >
        Focus sentinel
      </button>
    </div>
  </div>
</div>
`;

exports[`Desktop experience visual snapshots matches the global navigation shell 1`] = `
<div
  class="app-shell app-shell--themed-workspace app-shell--windowed"
  style="--window-shell-accent: #be95ff; --global-tree-width: 16rem; --global-tree-banner-left-offset: 16rem;"
>
  <div
    class="app-shell__frame"
  >
    <div
      class="cds--layer-two global-tree-nav__layer"
    >
      <aside
        aria-label="Global navigation tree"
        class="global-tree-nav"
      >
        <div
          class="global-tree-nav__header"
        >
          <div
            class="global-tree-nav__header-row"
          >
            <p
              class="global-tree-nav__eyebrow"
            >
              Global Navigation
            </p>
            <button
              aria-label="Unpin Navigation"
              aria-pressed="true"
              class="global-tree-nav__pin-button"
              type="button"
            >
              <svg
                aria-hidden="true"
                fill="currentColor"
                focusable="false"
                height="18"
                preserveAspectRatio="xMidYMid meet"
                viewBox="0 0 32 32"
                width="18"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M28.5858,13.3137,30,11.9,20,2,18.6858,3.415l1.1858,1.1857L8.38,14.3225,6.6641,12.6067,5.25,14l5.6572,5.6773L2,28.5831,3.41,30l8.9111-8.9087L18,26.7482l1.3929-1.414L17.6765,23.618l9.724-11.4895Z"
                />
              </svg>
            </button>
