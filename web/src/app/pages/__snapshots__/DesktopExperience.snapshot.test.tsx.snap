                  </div>
                  <h2
                    class="map2x-guide-section__title"
                  >
                    Get a node up.
                  </h2>
                  <p
                    class="map2x-guide-section__sub"
                  >
                    Targets Fedora Server 42+. Sources are AGPLv3.
                  </p>
                  <div
                    class="map2x-code-grid"
                  >
                    <div
                      class="map2x-panel"
                    >
                      <div
                        class="map2x-strip"
                      >
                        <div
                          class="map2x-mono map2x-strip__title"
                        >
                          Install
                        </div>
                        <button
                          class="map2x-ghost-btn"
                          type="button"
                        >
                          Copy
                        </button>
                      </div>
                      <pre
                        class="map2x-code"
                      >
                        # Clone
git clone https://github.com/matthewmackes/map2-audio.git
cd map2-audio

# Full install
sudo bash install_on_new_host.sh

# Skip AVB during install
sudo bash install_on_new_host.sh --skip-avb
                      </pre>
                    </div>
                    <div
                      class="map2x-panel"
                    >
                      <div
                        class="map2x-strip"
                      >
                        <div
                          class="map2x-mono map2x-strip__title"
                        >
                          Run
                        </div>
                        <button
                          class="map2x-ghost-btn"
                          type="button"
                        >
                          Copy
                        </button>
                      </div>
                      <pre
                        class="map2x-code"
                      >
                        # Backend API (port 8080)
systemctl start map2-backend

# Web dashboard (port 3000)
./scripts/start_web.sh

# Textual TUI
python -m tui.node_console

# Ink TUI
./map2-tui --screen diagnostics
                      </pre>
                    </div>
                  </div>
                  <div
                    class="map2x-callout map2x-callout--warn"
                  >
