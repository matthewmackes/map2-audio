              >
                <span
                  class="global-tree-nav__node-button-label"
                >
                  MAP2-TESTBED
                </span>
                <span
                  class="global-tree-nav__node-button-status"
                >
                  OK
                </span>
              </span>
            </button>
            <span
              class="cds--popover"
