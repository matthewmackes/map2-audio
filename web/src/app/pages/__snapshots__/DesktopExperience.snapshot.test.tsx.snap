                        MAP2-TESTBED
                      </h3>
                      <p
                        class="node-mini-card__subtitle"
                      >
                        MAP2-TESTBED
                      </p>
                    </div>
                    <div
                      class="cds--tag cds--tag--cool-gray"
                      id="tag-id-_r_2l_"
                    >
                      <span
                        class="cds--tag__label"
                        dir="auto"
                        title="All-In-One"
                      >
                        All-In-One
                      </span>
                    </div>
                  </div>
                  <div
                    class="node-mini-card__context"
                  >
                    <span>
                      Local studio view
                    </span>
                  </div>
                  <div
                    class="node-mini-card__status"
                  >
                    <span>
                      Status
                    </span>
                    <div
                      class="cds--tag cds--tag--green"
                      id="tag-id-_r_2m_"
                    >
                      <span
                        class="cds--tag__label"
                        dir="auto"
                        title="OK"
                      >
                        OK
                      </span>
                    </div>
                  </div>
                  <div
                    class="node-mini-card__health-row"
                  >
                    <span>
