              id="danger-description-_r_37_"
            >
              danger
            </span>
            Reboot system
          </button>
        </div>
      </div>
      <button
        class="cds--visually-hidden"
        type="button"
      >
        Focus sentinel
      </button>
    </div>
  </div>
  <div
    aria-hidden="true"
    class="cds--layer-one cds--modal shell-power-modal"
    role="presentation"
  >
    <div
