                  MAP2-TESTBED
                </span>
                <span
                  class="global-tree-nav__node-button-status"
                >
                  OK
                </span>
              </span>
            </button>
            <span
              class="cds--popover"
            >
              <span
                class="cds--popover-content global-tree-nav__node-popover"
              >
                <div
                  class="node-mini-card"
                  style="border-inline-start-color: #0f62fe;"
                >
                  <div
                    class="node-mini-card__header"
                  >
                    <div>
                      <h3
                        class="node-mini-card__title"
