              id="danger-description-_r_12_"
            >
              danger
            </span>
            Reboot system
          </button>
        </div>
      </div>
      <button
        class="cds--visually-hidden"
        type="button"
      >
        Focus sentinel
      </button>
    </div>
  </div>
  <div
