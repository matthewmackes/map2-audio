                class="hp2-home-shell__operations-shell"
              >
                <section
                  aria-label="MAP2 welcome hero"
                  class="wh-shell"
                  data-testid="welcome-hero"
                >
                  <div
                    class="wh-topbar"
                  >
                    <div
                      class="wh-topbar__left"
                    >
                      <span
                        aria-hidden="true"
                        class="wh-topbar__dot"
                      />
                      <span>
                        MAP2 · Live Operations Surface
                      </span>
