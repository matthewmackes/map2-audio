                  class="shell-kicker__breadcrumb-link"
                  href="/artifacts"
                >
                  Audio Artifacts
                </a>
                <span
                  class="shell-kicker__breadcrumb-sep"
                >
                  /
                </span>
              </span>
              <span
                class="shell-kicker__breadcrumb-item"
              >
                <span
                  aria-current="page"
                  class="shell-kicker__breadcrumb-current"
                >
                  Overview
                </span>
              </span>
            </nav>
            <div
              class="shell-kicker__eyebrow"
            >
              Audio Artifacts / Overview
            </div>
            <h1
              class="shell-kicker__title"
            >
              Audio Artifacts: Overview
            </h1>
          </div>
          <div
            aria-label="Workspace actions"
            class="shell-kicker__actions"
            role="toolbar"
          >
            <button
              aria-label="Close Audio Artifacts: Overview"
              class="shell-kicker__action shell-kicker__action--close"
              title="Close Audio Artifacts: Overview"
              type="button"
            >
              ×
            </button>
          </div>
        </div>
      </header>
      <div
        data-testid="artifacts-page"
      >
        Audio Artifacts Workspace
      </div>
    </main>
  </div>
  <div
    aria-hidden="true"
    class="cds--layer-one cds--modal shell-reboot-modal"
    role="presentation"
  >
    <div
      aria-label="Power"
      aria-modal="true"
      class="cds--modal-container cds--modal-container--sm"
      role="dialog"
    >
      <button
        class="cds--visually-hidden"
        type="button"
      >
        Focus sentinel
      </button>
      <div
        class="cds--modal-container-body"
      >
        <div
          class="cds--modal-header"
        >
          <h2
            class="cds--modal-header__label cds--type-delta"
          >
            Power
          </h2>
          <h2
            class="cds--modal-header__heading cds--type-beta"
          >
            Full platform reboot
          </h2>
          <div
            class="cds--modal-close-button"
          >
            <span
              class="cds--popover-container cds--popover--caret cds--popover--high-contrast cds--popover--left cds--tooltip cds--icon-tooltip"
            >
              <div
                class="cds--tooltip-trigger__wrapper"
              >
                <button
                  aria-label="Close"
                  aria-labelledby="tooltip-_r_3e_"
                  class="cds--modal-close cds--btn cds--btn--primary cds--btn--icon-only"
                  type="button"
                >
                  <svg
                    aria-hidden="true"
                    class="cds--modal-close__icon"
                    fill="currentColor"
                    focusable="false"
                    height="20"
                    preserveAspectRatio="xMidYMid meet"
                    viewBox="0 0 32 32"
                    width="20"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M17.4141 16 24 9.4141 22.5859 8 16 14.5859 9.4143 8 8 9.4141 14.5859 16 8 22.5859 9.4143 24 16 17.4141 22.5859 24 24 22.5859 17.4141 16z"
                    />
                  </svg>
                </button>
              </div>
              <span
                aria-hidden="true"
                class="cds--popover"
                id="tooltip-_r_3e_"
                role="tooltip"
              >
                <span
                  class="cds--popover-content cds--tooltip-content"
                >
                  Close
                </span>
                <span
                  class="cds--popover-caret"
                />
              </span>
            </span>
          </div>
        </div>
        <div
          class="cds--layer-two cds--modal-content cds--modal-scroll-content--no-fade"
        >
          <p
            class="shell-reboot-modal__lead"
          >
            This will perform a complete reboot of the MAP2 platform, including all audio services and the foundational operating system. Expect 20–60 seconds of downtime.
          </p>
          <div
            class="shell-reboot-modal__preflight-head"
          >
            <span>
              System readiness check
            </span>
          </div>
          <div
            class="shell-reboot-modal__preflight-skeleton"
          >
            <div
              class="shell-reboot-modal__preflight-row shell-reboot-modal__preflight-row--loading"
            />
            <div
              class="shell-reboot-modal__preflight-row shell-reboot-modal__preflight-row--loading"
            />
            <div
              class="shell-reboot-modal__preflight-row shell-reboot-modal__preflight-row--loading"
            />
            <div
              class="shell-reboot-modal__preflight-row shell-reboot-modal__preflight-row--loading"
            />
          </div>
          <p
            class="shell-reboot-modal__irrevocable"
          >
            Once confirmed, the reboot cannot be stopped.
          </p>
        </div>
        <div
          aria-busy="false"
          class="cds--modal-footer cds--btn-set"
        >
          <button
            class="cds--btn cds--btn--secondary"
            type="button"
          >
            Cancel
          </button>
          <button
            aria-describedby="danger-description-_r_3i_"
            class="cds--btn cds--btn--danger"
            type="button"
          >
            <span
              class="cds--visually-hidden"
              id="danger-description-_r_3i_"
            >
              danger
            </span>
            Reboot system
          </button>
        </div>
      </div>
      <button
        class="cds--visually-hidden"
        type="button"
      >
        Focus sentinel
      </button>
    </div>
  </div>
  <div
    aria-hidden="true"
    class="cds--layer-one cds--modal shell-power-modal"
    role="presentation"
  >
    <div
      aria-label="Power"
      aria-modal="true"
      class="cds--modal-container cds--modal-container--sm"
      role="dialog"
    >
      <button
        class="cds--visually-hidden"
        type="button"
      >
        Focus sentinel
      </button>
      <div
        class="cds--modal-container-body"
      >
        <div
          class="cds--modal-header"
        >
          <h2
            class="cds--modal-header__label cds--type-delta"
          >
            Power
          </h2>
          <h2
            class="cds--modal-header__heading cds--type-beta"
          >
            Restart backend
          </h2>
          <div
            class="cds--modal-close-button"
          >
            <span
              class="cds--popover-container cds--popover--caret cds--popover--high-contrast cds--popover--left cds--tooltip cds--icon-tooltip"
            >
              <div
                class="cds--tooltip-trigger__wrapper"
              >
                <button
                  aria-label="Close"
                  aria-labelledby="tooltip-_r_3l_"
                  class="cds--modal-close cds--btn cds--btn--primary cds--btn--icon-only"
                  type="button"
                >
                  <svg
                    aria-hidden="true"
                    class="cds--modal-close__icon"
                    fill="currentColor"
                    focusable="false"
                    height="20"
                    preserveAspectRatio="xMidYMid meet"
                    viewBox="0 0 32 32"
                    width="20"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M17.4141 16 24 9.4141 22.5859 8 16 14.5859 9.4143 8 8 9.4141 14.5859 16 8 22.5859 9.4143 24 16 17.4141 22.5859 24 24 22.5859 17.4141 16z"
                    />
                  </svg>
                </button>
              </div>
              <span
                aria-hidden="true"
                class="cds--popover"
                id="tooltip-_r_3l_"
                role="tooltip"
              >
                <span
                  class="cds--popover-content cds--tooltip-content"
                >
                  Close
                </span>
                <span
                  class="cds--popover-caret"
                />
              </span>
            </span>
          </div>
        </div>
        <div
          class="cds--layer-two cds--modal-content cds--modal-scroll-content--no-fade"
        >
          Restart the MAP2 backend service? Audio processing will pause briefly while the shell reconnects.
        </div>
        <div
          aria-busy="false"
          class="cds--modal-footer cds--btn-set"
        >
          <button
            class="cds--btn cds--btn--secondary"
            type="button"
          >
            Cancel
          </button>
          <button
            class="cds--btn cds--btn--primary"
            type="button"
          >
            Confirm restart
          </button>
        </div>
      </div>
      <button
        class="cds--visually-hidden"
        type="button"
      >
        Focus sentinel
      </button>
    </div>
  </div>
</div>
`;
