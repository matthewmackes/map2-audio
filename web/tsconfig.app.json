{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/map2/*": ["src/map2/*"]
    },

    /* Linting */
    "strict": false,
    "noUnusedLocals": false,
    "noFallthroughCasesInSwitch": false,
    "noUncheckedSideEffectImports": false
  },
  "include": [
    "src/main.tsx",
    "src/index.css",
    "src/vite-env.d.ts",
    "src/app/**/*",
    "src/map2/**/*"
  ],
  "exclude": [
    "src/map2/index.ts",
    "src/map2/components/MAP2Dashboard.tsx",
    "src/map2/components/ChainBuilder.tsx",
    "src/map2/components/ChainBuilder/**",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
