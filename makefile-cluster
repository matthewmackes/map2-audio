#!/usr/bin/env make

.PHONY: help cluster-setup cluster-docs cluster-test cluster-dev cluster-clean

help:
	@echo "MAP2 Audio Platform - Cluster Management Targets"
	@echo ""
	@echo "Setup & Development:"
	@echo "  make cluster-setup      - Install cluster management dependencies"
	@echo "  make cluster-dev        - Setup development environment"
	@echo ""
	@echo "Documentation:"
	@echo "  make cluster-docs       - Open cluster documentation (view all guides)"
	@echo "  make cluster-guide      - Show 50-task implementation guide"
	@echo ""
	@echo "Testing:"
	@echo "  make cluster-test       - Run cluster management tests"
	@echo "  make cluster-lint       - Lint cluster code"
	@echo ""
	@echo "Utilities:"
	@echo "  make cluster-clean      - Clean test artifacts"
	@echo "  make cluster-sim        - Start cluster simulator (when ready)"
	@echo ""
	@echo "Quick References:"
	@echo "  - Implementation Guide: CLUSTER_MANAGEMENT_IMPLEMENTATION_GUIDE.md"
	@echo "  - Project Summary:      CLUSTER_PROJECT_SUMMARY.md"
	@echo "  - Developer Guide:      CLUSTER_DEVELOPER_QUICKSTART.md"
	@echo ""

cluster-setup:
	@echo "Installing cluster management dependencies..."
	pip install cryptography>=42.0.0 msgpack>=1.0.0 psutil>=6.0.0
	@echo ""
	@echo "Creating Fedora standard directories..."
	mkdir -p /etc/map2/ssl
	mkdir -p /etc/map2/ssh
	mkdir -p /var/lib/map2/backups
	mkdir -p /var/lib/map2/config-repo
	mkdir -p /opt/map2/scripts
	mkdir -p /opt/map2/dashboards
	@echo "✅ Cluster setup complete"

cluster-dev: cluster-setup
	@echo "Setting up development environment..."
	@echo "  - Installing test dependencies"
	pip install pytest pytest-asyncio pytest-cov
	@echo "  - Setting MAP2_CLUSTER_ENABLED=true"
	export MAP2_CLUSTER_ENABLED=true
	@echo "✅ Development environment ready"

cluster-docs:
	@echo "📚 Cluster Management Documentation"
	@echo ""
	@echo "Files created:"
	@echo ""
	@echo "1️⃣  CLUSTER_MANAGEMENT_IMPLEMENTATION_GUIDE.md"
	@echo "   - 50-task roadmap with full specifications"
	@echo "   - 16 phases of implementation"
	@echo "   - API reference with examples"
	@echo "   - Architecture decisions"
	@echo ""
	@echo "2️⃣  CLUSTER_PROJECT_SUMMARY.md"
	@echo "   - Executive summary"
	@echo "   - Next 10 priority tasks"
	@echo "   - Key metrics and milestones"
	@echo ""
	@echo "3️⃣  CLUSTER_DEVELOPER_QUICKSTART.md"
	@echo "   - Quick reference for developers"
	@echo "   - Task #3 implementation guide"
	@echo "   - Code style and patterns"
	@echo ""
	@echo "To view full guide:"
	@echo "  less CLUSTER_MANAGEMENT_IMPLEMENTATION_GUIDE.md"
	@echo ""

cluster-guide:
	@echo "Opening full 50-task implementation guide..."
	less CLUSTER_MANAGEMENT_IMPLEMENTATION_GUIDE.md

cluster-test:
	@echo "Running cluster management tests..."
	pytest tests/test_cluster_management.py -v --cov=app.services.cluster
	@echo ""

cluster-lint:
	@echo "Linting cluster management code..."
	pylint app/services/cluster/*.py
	@echo ""

cluster-clean:
	@echo "Cleaning test artifacts..."
	find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true
	find . -type f -name "*.pyc" -delete
	rm -rf .pytest_cache
	@echo "✅ Clean complete"

cluster-sim:
	@echo "Cluster Simulator (available after Task #44)"
	@echo ""
	@echo "When implemented, run:"
	@echo "  python3 scripts/cluster_simulator.py --nodes 5 --runtime 3600"
	@echo ""

# Convenience targets for common tasks
.PHONY: install test docs clean

install: cluster-setup
test: cluster-test
docs: cluster-docs
clean: cluster-clean
