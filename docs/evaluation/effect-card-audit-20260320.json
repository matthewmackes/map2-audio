  "findings": [
    {
      "id": "F001",
      "severity": "critical",
      "title": "Custom effect-card subsystem is not wired into the active web app",
      "evidence": [
        "web/src/app/components/PluginCards/PluginCardRouter.tsx"
      ],
      "expected": "The card router should be mounted by an operator-facing route so custom cards, presets, and MIDI mapping are reachable.",
      "actual": "Within web/src/app, PluginCardRouter appears only in its own source file; JuceGridPage renders JuceGridParameterEditor directly."
    },
    {
      "id": "F002",
      "severity": "major",
      "title": "Multiple JUCE custom cards carry stale plugin URIs in MIDI mapping wrappers",
      "evidence": [
        {
          "card": "CabinetIRCard.tsx",
          "hardcoded_uris": [
            "map2://juce/ir/cabinet"
