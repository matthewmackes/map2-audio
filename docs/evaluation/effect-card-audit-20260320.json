          "hardcoded_uris": [
            "map2://juce/ir/reverb"
          ],
          "matches_registry": {
            "map2://juce/ir/reverb": false
          }
        }
      ],
      "expected": "withMidiDialog should use the same plugin URI the registry and discovery APIs expose.",
      "actual": "Five JUCE cards embed non-registered URIs, so their MIDI mapping dialog targets stale identities."
    },
