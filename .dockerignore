# .dockerignore for MAP2 Audio Platform

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Documentation (except what we need)
*.md
!README.md

# Tests
tests/
.pytest_cache/
.coverage
htmlcov/

# Database (will be in volume)
*.db
*.db-journal
*.sqlite
*.sqlite3

# Logs
*.log
logs/

# Node (for web)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
web/dist/
web/build/

# Scripts we don't need in container
*.sh
!scripts/*.sh

# Packaging
packaging/

# Temporary files
tmp/
temp/
*.tmp
