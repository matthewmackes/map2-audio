# map2-services SPEC stub
# Purpose: systemd units, sysusers, tmpfiles, health scripts.

Name:           map2-services
Version:        0.1.0
Release:        1%{?dist}
Summary:        MAP2 service units and operational scripts
License:        AGPL-3.0-only
Source0:        %{name}-%{version}.tar.gz
BuildRequires:  systemd-rpm-macros
Requires(post): systemd
Requires(preun): systemd
Requires(postun): systemd
Requires:       map2-core = %{version}-%{release}

