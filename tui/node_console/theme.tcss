/*
 * MAP2 Node Console — Textual CSS Theme
 *
 * Design philosophy:
 *   - Clean, structured, Anaconda-installer inspired
 *   - High information density with clear visual hierarchy
 *   - Green/yellow/red health indicators on dark background
 *   - Excellent readability over SSH on 80×24 to 120×40 terminals
 *   - No animations or flicker-prone effects
 */


/* ── Global ────────────────────────────────────────────────────────────── */

Screen {
    background: $surface;
}

/* ── Header / Footer ──────────────────────────────────────────────────── */

Header {
    dock: top;
    height: 1;
    background: $primary;
    color: $text;
}

Footer {
    dock: bottom;
    height: 1;
}

/* ── Tabs ──────────────────────────────────────────────────────────────── */

TabbedContent {
    height: 1fr;
}

TabPane {
    padding: 1 1;
}

Tabs {
    dock: top;
    height: 3;
    background: $primary-darken-2;
}

Tab {
    padding: 0 2;
}

Tab.-active {
    background: $primary;
    text-style: bold;
    color: $text;
}

/* ── Section containers ───────────────────────────────────────────────── */

.section-box {
    border: solid $primary-lighten-1;
    padding: 1 2;
    margin: 0 0 1 0;
    background: $surface-darken-1;
    height: auto;
}

.section-title {
    text-style: bold;
    color: $primary-lighten-2;
    margin-bottom: 1;
}

/* ── Metric rows ──────────────────────────────────────────────────────── */

.metric-row {
    height: 1;
    layout: horizontal;
}

.metric-label {
    width: 20;
    color: $text-muted;
}

.metric-value {
    width: 1fr;
    color: $text;
}

/* ── Health indicators ────────────────────────────────────────────────── */

.health-healthy {
    color: $success;
    text-style: bold;
}

.health-warning {
    color: $warning;
    text-style: bold;
}

.health-critical {
    color: $error;
    text-style: bold;
}

.health-unknown {
    color: $text-disabled;
}

/* ── Dashboard grid ───────────────────────────────────────────────────── */

.dashboard-grid {
    layout: grid;
    grid-size: 2;
    grid-gutter: 1;
    height: auto;
    padding: 0;
}

.dashboard-full-width {
    column-span: 2;
}

/* ── Status overview / big banner ─────────────────────────────────────── */

.status-banner {
    height: 3;
    border: heavy $primary;
    background: $surface-darken-2;
    padding: 0 2;
    content-align: center middle;
    text-style: bold;
    margin-bottom: 1;
}

.status-banner-healthy {
    border: heavy $success;
    color: $success;
}

.status-banner-warning {
    border: heavy $warning;
    color: $warning;
}

.status-banner-critical {
    border: heavy $error;
    color: $error;
}

/* ── Data tables ──────────────────────────────────────────────────────── */

DataTable {
    height: auto;
    max-height: 16;
    margin: 0;
}

DataTable > .datatable--header {
    text-style: bold;
    background: $primary-darken-2;
    color: $text;
}

/* ── Buttons ──────────────────────────────────────────────────────────── */

Button {
    margin: 0 1;
    min-width: 16;
}

Button.btn-danger {
    background: $error;
    color: $text;
}

Button.btn-warning {
    background: $warning;
    color: $text;
}

Button.btn-success {
    background: $success;
    color: $text;
}

/* ── Action bar ───────────────────────────────────────────────────────── */

.action-bar {
    dock: bottom;
    height: 3;
    layout: horizontal;
    padding: 0 1;
    background: $surface-darken-1;
    border-top: solid $primary-lighten-1;
    align: center middle;
}

/* ── Log view ─────────────────────────────────────────────────────────── */

RichLog {
    height: 1fr;
    border: solid $primary-lighten-1;
    background: $surface-darken-2;
    scrollbar-size: 1 1;
}

/* ── Modal screens ────────────────────────────────────────────────────── */

.modal-dialog {
    width: 60;
    max-width: 80%;
    height: auto;
    max-height: 20;
    border: thick $warning;
    background: $surface;
    padding: 1 2;
}

.modal-title {
    text-style: bold;
    color: $warning;
    margin-bottom: 1;
    text-align: center;
}

.modal-body {
    margin-bottom: 1;
}

.modal-buttons {
    layout: horizontal;
    height: 3;
    align: center middle;
}

/* ── Cluster table ────────────────────────────────────────────────────── */

.cluster-section {
    height: auto;
    margin: 0 0 1 0;
}

/* ── Node actions ─────────────────────────────────────────────────────── */

.mode-selector {
    height: auto;
    padding: 1 2;
    border: solid $primary-lighten-1;
    background: $surface-darken-1;
    margin-bottom: 1;
}

.mode-current {
    text-style: bold;
    color: $success;
    margin-bottom: 1;
}

RadioSet {
    height: auto;
    margin: 1 0;
}

/* ── Help screen ──────────────────────────────────────────────────────── */

.help-section {
    margin: 0 0 1 0;
}

.help-title {
    text-style: bold underline;
    color: $primary-lighten-2;
    margin-bottom: 1;
}

.help-key {
    color: $warning;
    text-style: bold;
}

/* ── Responsive: smaller terminals ────────────────────────────────────── */

.hide-narrow {
    display: block;
}

/* ── Events log ───────────────────────────────────────────────────────── */

.events-box {
    height: auto;
    max-height: 10;
    border: solid $primary-lighten-1;
    background: $surface-darken-2;
    padding: 0 1;
    overflow-y: auto;
}

/* ── Filter bar for logs ──────────────────────────────────────────────── */

.filter-bar {
    dock: top;
    height: 3;
    layout: horizontal;
    padding: 0 1;
    background: $surface-darken-1;
}

.filter-bar Select {
    width: 24;
    margin-right: 1;
}

.filter-bar Input {
    width: 1fr;
}

/* ── Progress indicator ───────────────────────────────────────────────── */

.progress-label {
    text-align: center;
    margin: 1 0;
    color: $text-muted;
}
