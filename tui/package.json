{
  "name": "map2-ink-tui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "tsx src/main.tsx",
    "build": "tsc -p tsconfig.json --noEmit",
    "test:unit": "node ../node_modules/jest/bin/jest.js --config ./jest.config.cjs --runInBand",
    "test:ink": "tsx src/inkSmoke.tsx",
    "test": "npm run test:unit && npm run test:ink",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "ink": "^6.8.0",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.2",
    "eslint": "^9.38.0",
    "globals": "^16.4.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1"
  },
  "overrides": {
    "ws": "^8.20.1"
  }
}
