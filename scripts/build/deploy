#!/bin/bash
# ═══════════════════════════════════════════════════════════════
# MAP2 Audio — Quick Deploy to Production (Port 3000)
# ═══════════════════════════════════════════════════════════════
#
# Usage:  ./scripts/build/deploy          # full build + restart
#         ./scripts/build/deploy --skip-build   # restart only (use existing dist/)
#         ./scripts/build/deploy --status       # show current status
#
# This script:
#   1. Builds the web app (npm run build → dist/)
#   2. Restarts the production server on port 3000
#   3. Verifies the deployment is live via the production web runtime
#
# The dev server on port 3001 is NOT touched.
# ═══════════════════════════════════════════════════════════════

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
WEB_DIR="$ROOT_DIR/web"
LOG_DIR="$ROOT_DIR/logs"
PROD_PORT=3000
SERVICE_NAME="map2-web-prod"
SERVER_SCRIPT="$ROOT_DIR/scripts/serve_web_dist.mjs"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

log()   { echo -e "${GREEN}✓${NC} $*"; }
warn()  { echo -e "${YELLOW}⚠${NC} $*"; }
err()   { echo -e "${RED}✗${NC} $*" >&2; }
info()  { echo -e "${CYAN}→${NC} $*"; }
header(){ echo -e "\n${BOLD}$*${NC}"; }

port_pids() {
    lsof -i :"$PROD_PORT" -sTCP:LISTEN -t 2>/dev/null || true
}

service_active_state() {
    systemctl show -p ActiveState --value "$SERVICE_NAME" 2>/dev/null || true
}

wait_for_port_release() {
    local timeout_seconds=${1:-10}
    local deadline=$((SECONDS + timeout_seconds))

    while port_pids | grep -q .; do
        if (( SECONDS >= deadline )); then
            return 1
        fi
        sleep 0.2
    done
}

wait_for_service_stop() {
    local timeout_seconds=${1:-10}
    local deadline=$((SECONDS + timeout_seconds))

    while true; do
        local active_state
        active_state=$(service_active_state)
        if [[ -z "$active_state" || "$active_state" == "inactive" || "$active_state" == "failed" ]]; then
            return 0
        fi
        if (( SECONDS >= deadline )); then
            return 1
        fi
        sleep 0.2
    done
}

# ── Status command ──────────────────────────────────────────
show_status() {
    header "MAP2 Production Status"
    
    # Check port 3000
    if lsof -i :$PROD_PORT -sTCP:LISTEN &>/dev/null; then
        local pid=$(lsof -i :$PROD_PORT -sTCP:LISTEN -t 2>/dev/null | head -1)
        log "Port $PROD_PORT: ${GREEN}LISTENING${NC} (PID: $pid)"
    else
        err "Port $PROD_PORT: NOT LISTENING"
    fi

    # Check systemd service
    if systemctl is-active --quiet "$SERVICE_NAME" 2>/dev/null; then
        log "Service $SERVICE_NAME: ${GREEN}active${NC}"
    else
        warn "Service $SERVICE_NAME: inactive (using manual mode)"
    fi

    # Check dist/ freshness
    if [[ -f "$WEB_DIR/dist/index.html" ]]; then
        local age=$(( ($(date +%s) - $(stat -c %Y "$WEB_DIR/dist/index.html")) ))
        if (( age < 60 )); then
            log "Build: ${age}s ago"
        elif (( age < 3600 )); then
            log "Build: $((age/60))m ago"
        else
            warn "Build: $((age/3600))h $((age%3600/60))m ago"
        fi
        local bundle_hash
        bundle_hash=$(curl -sf --max-time 2 "http://localhost:$PROD_PORT/" | grep -o 'index-[^"]*\.js' | head -1 || true)
        if [[ -n "$bundle_hash" ]]; then
            log "Live bundle: $bundle_hash"
        fi
    else
        err "No build found — run: ./scripts/build/deploy"
    fi

    # Check dev server
    if lsof -i :3001 -sTCP:LISTEN &>/dev/null; then
        log "Dev server (3001): ${GREEN}running${NC}"
    else
        warn "Dev server (3001): not running"
    fi

    # Quick health check
    if curl -sf --max-time 2 "http://localhost:$PROD_PORT/" &>/dev/null; then
        log "Health check: ${GREEN}OK${NC}"
    else
        err "Health check: FAILED"
    fi
    echo
}

# ── Stop production server ──────────────────────────────────
stop_prod() {
    info "Stopping production server..."

    # Try systemd first
    local active_state
    active_state=$(service_active_state)
    if [[ "$active_state" == "active" || "$active_state" == "activating" || "$active_state" == "deactivating" ]]; then
        sudo systemctl stop --no-block "$SERVICE_NAME" 2>/dev/null || true
        if wait_for_service_stop 10; then
            log "Stopped $SERVICE_NAME service"
        else
            warn "$SERVICE_NAME stop timed out; sending SIGKILL to the unit"
            sudo systemctl kill --signal=KILL "$SERVICE_NAME" 2>/dev/null || true
            if ! wait_for_service_stop 5; then
                err "$SERVICE_NAME did not stop cleanly after SIGKILL"
                return 1
            fi
            log "Stopped $SERVICE_NAME service after forced kill"
        fi
    fi

    # Fall back to killing the process on the port
    local pids
    pids=$(port_pids)
    if [[ -n "$pids" ]]; then
        echo "$pids" | xargs kill 2>/dev/null
        wait_for_port_release 5 || true
        # Force kill if still running
        pids=$(port_pids)
        if [[ -n "$pids" ]]; then
            echo "$pids" | xargs kill -9 2>/dev/null
            wait_for_port_release 5 || true
        fi
        if port_pids | grep -q .; then
            err "Port $PROD_PORT is still busy after restart cleanup"
            return 1
        fi
        log "Killed processes on port $PROD_PORT"
    else
        log "Port $PROD_PORT already free"
    fi
}

# ── Start production server ─────────────────────────────────
start_prod() {
    info "Starting production server on port $PROD_PORT..."

    # Try systemd first
    if systemctl list-unit-files "$SERVICE_NAME.service" &>/dev/null 2>&1; then
        if sudo systemctl start "$SERVICE_NAME" 2>/dev/null; then
            log "Started $SERVICE_NAME via systemd"
            return 0
        fi
    fi

    # Fall back to the same direct node runtime the production unit uses.
    nohup /usr/bin/node "$SERVER_SCRIPT" --host 0.0.0.0 --port "$PROD_PORT" \
        > "$LOG_DIR/web-prod.log" 2>&1 &
    local pid=$!
    disown $pid
    log "Started direct production server manually (PID: $pid)"
}

# ── Verify deployment ───────────────────────────────────────
verify() {
    info "Verifying deployment..."
    if curl --silent --show-error --fail \
        --retry 30 --retry-delay 0 --retry-connrefused --retry-all-errors --retry-max-time 15 \
        --output /dev/null "http://localhost:$PROD_PORT/"; then
        local bundle_hash
        bundle_hash=$(curl -sf --max-time 2 "http://localhost:$PROD_PORT/" | grep -o 'index-[^"]*\.js' | head -1 || true)
        log "Production server is live at http://localhost:$PROD_PORT"
        [[ -n "$bundle_hash" ]] && log "Serving bundle: $bundle_hash"
        return 0
    fi

    err "Server did not respond on port $PROD_PORT"
    return 1
}

# ── Build ───────────────────────────────────────────────────
build() {
    header "Building production bundle..."
    cd "$WEB_DIR"

    local start_time=$(date +%s)
    
    # Run the build
    if NODE_ENV=production npm run build 2>&1 | tee "$LOG_DIR/deploy-build.log" | grep -E "✓ built|error TS|Error:" | tail -20; then
        local elapsed=$(( $(date +%s) - start_time ))
        log "Build completed in ${elapsed}s"
    else
        # Check if vite build succeeded despite tsc warnings
        if [[ -f "$WEB_DIR/dist/index.html" ]]; then
            local build_time=$(stat -c %Y "$WEB_DIR/dist/index.html")
            if (( build_time > start_time )); then
                local elapsed=$(( $(date +%s) - start_time ))
                log "Build completed in ${elapsed}s (with TypeScript warnings)"
            else
                err "Build failed — dist/ was not updated"
                err "Check: $LOG_DIR/deploy-build.log"
                exit 1
            fi
        else
            err "Build failed — no dist/ created"
            err "Check: $LOG_DIR/deploy-build.log"
            exit 1
        fi
    fi
}

# ── Main ────────────────────────────────────────────────────
main() {
    local skip_build=false

    for arg in "$@"; do
        case "$arg" in
            --status)    show_status; exit 0 ;;
            --skip-build) skip_build=true ;;
            --help|-h)
                echo "Usage: $0 [--skip-build] [--status] [--help]"
                echo ""
                echo "  --skip-build   Restart server without rebuilding"
                echo "  --status       Show current deployment status"
                echo "  --help         Show this help"
                exit 0
                ;;
        esac
    done

    mkdir -p "$LOG_DIR"

    echo -e "${BOLD}═══════════════════════════════════════════════════${NC}"
    echo -e "${BOLD}  MAP2 Deploy to Production (Port $PROD_PORT)${NC}"
    echo -e "${BOLD}═══════════════════════════════════════════════════${NC}"

    # Step 1: Build (unless skipped)
    if [[ "$skip_build" == false ]]; then
        build
    else
        if [[ ! -f "$WEB_DIR/dist/index.html" ]]; then
            err "No dist/ found — cannot skip build"
            exit 1
        fi
        warn "Skipping build (using existing dist/)"
    fi

    # Step 2: Stop old server
    stop_prod

    # Step 3: Start new server
    start_prod

    # Step 4: Verify
    verify

    echo
    echo -e "${BOLD}═══════════════════════════════════════════════════${NC}"
    echo -e "  ${GREEN}✓ Deployed successfully${NC}"
    echo -e "  ${CYAN}http://localhost:$PROD_PORT${NC}"
    echo -e "  ${CYAN}http://172.20.234.234:$PROD_PORT${NC}"
    echo -e "${BOLD}═══════════════════════════════════════════════════${NC}"
}

main "$@"
