#!/bin/bash
# ============================================================================
# DEPLOY-TO-PRODUCTION - Deploy web interface changes to production (port 3000)
# Uses MATTS-BUILD-TUI build system to create optimized bundle and deploy
# ============================================================================

set -e

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
WEB_DIR="$PROJECT_ROOT/web"
BUILD_DIR="$PROJECT_ROOT/build"
PROD_DIST="/var/www/map2-prod/dist"
HELPERS_DIR="$PROJECT_ROOT/scripts/build"
LOGS_DIR="$PROJECT_ROOT/logs"
DEPLOY_LOG="$LOGS_DIR/deploy-$(date +%Y%m%d_%H%M%S).log"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# Ensure directories exist
mkdir -p "$LOGS_DIR"
touch "$DEPLOY_LOG"

# ============================================================================
# FUNCTIONS
# ============================================================================

print_header() {
    echo -e "\n${CYAN}╔════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${NC} $1"
    echo -e "${CYAN}╚════════════════════════════════════════════════════════════╝${NC}\n"
}

print_status() {
    echo -e "${BLUE}[INFO]${NC} $1"
    echo "$(date '+%Y-%m-%d %H:%M:%S') [INFO] $1" >> "$DEPLOY_LOG"
}

print_success() {
    echo -e "${GREEN}[✓]${NC} $1"
    echo "$(date '+%Y-%m-%d %H:%M:%S') [SUCCESS] $1" >> "$DEPLOY_LOG"
}

print_error() {
    echo -e "${RED}[✗]${NC} $1"
    echo "$(date '+%Y-%m-%d %H:%M:%S') [ERROR] $1" >> "$DEPLOY_LOG"
}

print_warning() {
    echo -e "${YELLOW}[⚠]${NC} $1"
    echo "$(date '+%Y-%m-%d %H:%M:%S') [WARNING] $1" >> "$DEPLOY_LOG"
}

# ============================================================================
# MAIN DEPLOYMENT PROCESS
# ============================================================================

main() {
    print_header "DEPLOY WEB INTERFACE TO PRODUCTION (PORT 3000)"
    
    echo -e "${CYAN}Summary:${NC}"
    echo "  Project Root: $PROJECT_ROOT"
    echo "  Web Directory: $WEB_DIR"
    echo "  Build Output: $WEB_DIR/dist"
    echo "  Deploy Log: $DEPLOY_LOG"
    echo ""
    
    # Step 1: Check prerequisites
    print_status "Checking prerequisites..."
    
    if [ ! -d "$WEB_DIR" ]; then
        print_error "Web directory not found: $WEB_DIR"
        exit 1
    fi
    
    if [ ! -f "$WEB_DIR/package.json" ]; then
        print_error "package.json not found in $WEB_DIR"
        exit 1
    fi
    
    if ! command -v node &>/dev/null; then
        print_error "Node.js not installed"
        exit 1
    fi
    
    if ! command -v npm &>/dev/null; then
        print_error "npm not installed"
        exit 1
    fi
    
    print_success "All prerequisites met"
    
    # Step 2: Check if production service is running (do not stop yet)
    print_status "Checking production service status on port 3000..."
    local service_was_running=false
    if lsof -i :3000 >/dev/null 2>&1; then
        service_was_running=true
        print_warning "Port 3000 is in use (production service running)"
    else
        print_success "Port 3000 is available"
    fi

    # Step 3: Prepare build cache (preserve dist/ for hash compatibility)
    print_status "Preparing build cache..."
    cd "$WEB_DIR"
    rm -rf build .next out 2>/dev/null || true
    rm -rf node_modules/.cache 2>/dev/null || true
    print_success "Build cache prepared (dist/ preserved)"

    # Step 4: Install dependencies
    if [ ! -d "node_modules" ]; then
        print_status "Installing npm dependencies..."
        if npm ci --legacy-peer-deps 2>&1 | tee -a "$DEPLOY_LOG"; then
            print_success "Dependencies installed"
        else
            print_error "Failed to install dependencies"
            exit 1
        fi
    else
        print_status "Dependencies already installed, skipping npm ci"
    fi
    
    # Step 5: Build production bundle
    print_status "Building optimized production bundle..."
    export NODE_ENV=production
    export PORT=3000
    
    if npm run build 2>&1 | tee -a "$DEPLOY_LOG"; then
        print_success "Production build completed successfully"
    else
        print_error "Production build failed"
        exit 1
    fi
    
    # Step 6: Verify build output
    if [ ! -d "$WEB_DIR/dist" ]; then
        print_error "Build output directory not created at $WEB_DIR/dist"
        exit 1
    fi
    
    local dist_size=$(du -sh "$WEB_DIR/dist" | awk '{print $1}')
    print_success "Build output created: $dist_size"
    
    # Step 7: List build artifacts
    print_status "Build artifacts:"
    ls -lh "$WEB_DIR/dist" | head -10
    
    # Step 8: Stop old production service after build is ready
    if [ "$service_was_running" = true ]; then
        print_status "Stopping current production service..."
        if sudo systemctl is-active --quiet map2-web-prod 2>/dev/null; then
            sudo systemctl stop map2-web-prod || print_warning "Could not stop systemd service"
            sleep 1
        else
            sudo lsof -i :3000 -t | xargs -r sudo kill -9 2>/dev/null || true
            sleep 1
        fi
    fi

    # Step 9: Start production service
    print_status "Starting production service on port 3000..."
    
    if sudo systemctl is-enabled map2-web-prod 2>/dev/null; then
        print_status "Starting via systemd service..."
        if sudo systemctl start map2-web-prod 2>&1 | tee -a "$DEPLOY_LOG"; then
            print_success "Production service started via systemd"
        else
            print_warning "systemd service failed, attempting manual start"
        fi
    else
        print_status "Starting manual server..."
        # Start serve in background
        cd "$WEB_DIR"
        if npx serve -s dist -l 3000 > /tmp/map2-prod-serve.log 2>&1 &
        then
            sleep 2
            print_success "Manual server started"
        else
            print_error "Failed to start server"
            exit 1
        fi
    fi
    
    # Step 10: Verify deployment
    print_status "Verifying deployment (waiting for port 3000)..."
    
    local retry=0
    local max_retries=10
    while [ $retry -lt $max_retries ]; do
        if lsof -i :3000 >/dev/null 2>&1; then
            print_success "Port 3000 is responding"
            break
        fi
        retry=$((retry + 1))
        echo -n "."
        sleep 1
    done
    
    if [ $retry -eq $max_retries ]; then
        print_warning "Port 3000 did not respond within timeout"
    fi
    
    # Step 11: Test deployment
    print_status "Testing production endpoint..."
    
    if curl -s http://localhost:3000 >/dev/null 2>&1; then
        print_success "Production service is responding on http://localhost:3000"
    else
        print_warning "Could not reach production service, it may still be starting"
    fi
    
    # Step 12: Show summary
    print_header "DEPLOYMENT COMPLETE"
    
    echo -e "${GREEN}✓ SUCCESS - Web interface deployed to production${NC}\n"
    
    cat <<EOF
${CYAN}Deployment Summary:${NC}
  
  Production Server:  http://localhost:3000
  Build Size:         $dist_size
  Deployment Time:    $(date)
  Deploy Log:         $DEPLOY_LOG
  
${CYAN}What Changed:${NC}
  • Enhanced plugin card designs (Peavey5150, EventideH9, ShoeGaze, Celestial)
  • Optimized CSS with animations and visual improvements
  • Latest formatter fixes applied
  • Production-grade minified bundle
  
${CYAN}Next Steps:${NC}
  1. Visit http://localhost:3000 in your browser
  2. Check browser console for any errors
  3. Navigate to plugin cards to see enhancements
  4. Run full system test: /home/mm/map2-audio/MATTS-BUILD-TUI --status
  
${CYAN}Rollback:${NC}
  If issues occur, restore previous version:
    sudo systemctl restart map2-web-prod
    Or redeploy from previous commit:
    git checkout HEAD~1 -- web/
    /home/mm/map2-audio/scripts/build/deploy-to-production

EOF
    
    print_status "Logs available at: $DEPLOY_LOG"
    
    return 0
}

# ============================================================================
# ERROR HANDLING
# ============================================================================

trap 'print_error "Deployment failed"; tail -20 "$DEPLOY_LOG"; exit 1' ERR

# ============================================================================
# ENTRY POINT
# ============================================================================

case "${1:-}" in
    --help|-h)
        cat <<'HELP'
DEPLOY-TO-PRODUCTION - Deploy web interface to production (port 3000)

Usage: deploy-to-production [OPTIONS]

OPTIONS:
  --help, -h          Show this help message
  --log               Show deployment log
  --rollback          Rollback to previous version
  --status            Check deployment status
  (no args)           Perform full deployment

EXAMPLES:
  deploy-to-production          # Deploy latest changes
  deploy-to-production --status  # Check status
  deploy-to-production --log     # View deployment log

FEATURES:
  • Stops existing production service
  • Builds optimized production bundle
  • Deploys to /web/dist
  • Starts production server on port 3000
  • Verifies deployment
  • Provides detailed logging

DEPLOYMENT PROCESS:
  1. Checks prerequisites (Node.js, npm)
  2. Stops current production service
  3. Cleans previous build artifacts
  4. Installs dependencies
  5. Builds production bundle
  6. Verifies build output
  7. Starts production service
  8. Tests deployment
  9. Provides rollback instructions

HELP
        exit 0
        ;;
    --log)
        if [ -f "$DEPLOY_LOG" ]; then
            tail -100 "$DEPLOY_LOG"
        else
            echo "No deployment log found yet"
        fi
        exit 0
        ;;
    --status)
        if lsof -i :3000 >/dev/null 2>&1; then
            echo "✓ Production service running on port 3000"
            curl -s -I http://localhost:3000 | head -5
            exit 0
        else
            echo "✗ Production service not running on port 3000"
            exit 1
        fi
        ;;
    --rollback)
        print_header "ROLLBACK TO PREVIOUS VERSION"
        print_warning "Rollback feature requires manual intervention"
        echo "To rollback:"
        echo "  1. Stop production service: sudo systemctl stop map2-web-prod"
        echo "  2. Revert changes: git checkout HEAD~1 -- web/"
        echo "  3. Run deployment again: $(basename "$0")"
        exit 0
        ;;
    "")
        main
        ;;
    *)
        print_error "Unknown option: $1"
        exit 1
        ;;
esac
