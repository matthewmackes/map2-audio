#!/bin/bash

set -euo pipefail

if [[ "${MAP2_SHELL_NO_COLOR:-0}" != "1" && -z "${NO_COLOR:-}" && "${TERM:-dumb}" != "dumb" ]]; then
    COLOR_PRIMARY="\033[38;2;15;98;254m"
    COLOR_MUTED="\033[38;2;198;198;198m"
    COLOR_WARNING="\033[38;2;241;194;27m"
    COLOR_RESET="\033[0m"
else
    COLOR_PRIMARY=""
    COLOR_MUTED=""
    COLOR_WARNING=""
    COLOR_RESET=""
fi

printf '%bMAP2 shell setup%b\n' "${COLOR_PRIMARY}" "${COLOR_RESET}"
printf '%s\n' '────────────────────────────────────────────────────────────'
printf '%bDeprecated:%b MAP2 no longer installs or recommends third-party shell frameworks from this script.\n' "${COLOR_WARNING}" "${COLOR_RESET}"
printf '%bCurrent behavior:%b the platform ships a purpose-built Carbon prompt in branding/map2-welcome.sh.\n' "${COLOR_MUTED}" "${COLOR_RESET}"
printf '%bUse instead:%b source the MAP2 shell profile or launch the unified console with map2.\n' "${COLOR_MUTED}" "${COLOR_RESET}"
printf '%bNo action taken.%b\n' "${COLOR_WARNING}" "${COLOR_RESET}"
