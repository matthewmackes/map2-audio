#!/bin/bash
#
# Airwindows LV2 Build Script
# Builds Airwindows plugins as LV2 from source
#
# Source: https://github.com/hannesbraun/airwindows-lv2
# Original: https://github.com/airwindows/airwindows
# License: MIT
#
# Usage: bash scripts/build-airwindows.sh [--install] [--plugin PLUGIN_NAME]
#
# Examples:
#   bash scripts/build-airwindows.sh --install                    # Build all plugins
#   bash scripts/build-airwindows.sh --install --plugin GlitchShifter  # Build specific plugin
#

set -e

# Color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# Configuration
AIRWINDOWS_REPO="https://github.com/hannesbraun/airwindows-lv2"
BUILD_DIR="${BUILD_DIR:-/tmp/airwindows-lv2-build}"
INSTALL_DIR="${HOME}/.lv2"
INSTALL_SYSTEM=false
SPECIFIC_PLUGIN=""
JOBS=$(nproc)

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --install)
            INSTALL_SYSTEM=true
            shift
            ;;
        --plugin|-p)
            shift
            SPECIFIC_PLUGIN="$1"
            shift
            ;;
        --jobs|-j)
            shift
            JOBS="$1"
            shift
            ;;
        --build-dir)
            shift
            BUILD_DIR="$1"
            shift
            ;;
        --system)
            INSTALL_DIR="/usr/lib/lv2"
            shift
            ;;
        --help)
            echo "Usage: $0 [OPTIONS]"
            echo ""
            echo "Options:"
            echo "  --install              Install after building"
            echo "  --plugin NAME          Build specific plugin (e.g., GlitchShifter)"
            echo "  --system               Install to system /usr/lib/lv2 (requires sudo)"
            echo "  --jobs N               Number of parallel build jobs (default: $JOBS)"
            echo "  --build-dir DIR        Build directory (default: $BUILD_DIR)"
            echo "  --help                 Show this help message"
            echo ""
            echo "Available plugins include:"
            echo "  GlitchShifter, Chorus, Console, Compressor, Density, Drive,"
            echo "  DeRez, EQ, Galactic, Golem, Hermes, IronOxide, MV, PurestDrive,"
            echo "  Slew, Tape, ToTape, TubeDesk, Verbity, VoiceOfTheStarship..."
            echo ""
            echo "Full list at: https://github.com/hannesbraun/airwindows-lv2"
            exit 0
            ;;
        *)
            echo "Unknown option: $1"
            exit 1
            ;;
    esac
done

log_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
log_warning() { echo -e "${YELLOW}[WARNING]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }
log_highlight() { echo -e "${CYAN}[AIRWINDOWS]${NC} $1"; }

print_header() {
    echo -e "${CYAN}========================================${NC}"
    echo -e "${CYAN}$1${NC}"
    echo -e "${CYAN}========================================${NC}"
}

# Detect distribution
detect_distro() {
    if [ -f /etc/fedora-release ]; then
        echo "fedora"
    elif [ -f /etc/debian_version ]; then
        echo "debian"
    elif [ -f /etc/arch-release ]; then
        echo "arch"
    elif [ -f /etc/gentoo-release ]; then
        echo "gentoo"
    elif [ -f /etc/SuSE-release ] || [ -f /etc/SUSE-brand ]; then
        echo "suse"
    else
        echo "unknown"
    fi
}

# Install dependencies for Fedora
install_deps_fedora() {
    log_info "Installing Fedora build dependencies..."
    sudo dnf install -y \
        meson \
        ninja-build \
        gcc-c++ \
        git \
        lv2-devel
}

# Install dependencies for Debian/Ubuntu
install_deps_debian() {
    log_info "Installing Debian/Ubuntu build dependencies..."
    sudo apt-get update
    sudo apt-get install -y \
        build-essential \
        meson \
        ninja-build \
        git \
        lv2-dev
}

# Install dependencies for Arch
install_deps_arch() {
    log_info "Installing Arch Linux build dependencies..."
    sudo pacman -S --needed --noconfirm \
        meson \
        ninja \
        gcc \
        git \
        lv2
}

# Install dependencies for openSUSE
install_deps_suse() {
    log_info "Installing openSUSE build dependencies..."
    sudo zypper install -y \
        meson \
        ninja \
        gcc-c++ \
        git \
        lv2-devel
}

# Install dependencies based on distribution
install_dependencies() {
    print_header "Installing Build Dependencies"

    DISTRO=$(detect_distro)
    log_info "Detected distribution: $DISTRO"

    case $DISTRO in
        fedora)
            install_deps_fedora
            ;;
        debian)
            install_deps_debian
            ;;
        arch)
            install_deps_arch
            ;;
        suse)
            install_deps_suse
            ;;
        *)
            log_warning "Unknown distribution. Please install dependencies manually:"
            echo "  - meson, ninja-build, gcc/g++, git, lv2-dev"
            read -p "Continue anyway? (y/n) " -n 1 -r
            echo
            if [[ ! $REPLY =~ ^[Yy]$ ]]; then
                exit 1
            fi
            ;;
    esac

    log_success "Dependencies installed"
}

# Clone and prepare source
prepare_source() {
    print_header "Preparing Airwindows Source Code"

    # Create build directory
    mkdir -p "$BUILD_DIR"
    cd "$BUILD_DIR"

    # Clone or update repository
    if [ -d "airwindows-lv2" ]; then
        log_info "Updating existing source..."
        cd airwindows-lv2
        git fetch --all
        git pull || true
    else
        log_info "Cloning Airwindows LV2 repository..."
        git clone --depth 1 "$AIRWINDOWS_REPO.git" airwindows-lv2
        cd airwindows-lv2
    fi

    log_success "Source code ready"
}

# Configure build
configure_build() {
    print_header "Configuring Build"

    cd "$BUILD_DIR/airwindows-lv2"

    # Remove existing build directory for clean build
    rm -rf build

    log_info "Running Meson configuration..."

    # Configure with meson (airwindows-lv2 uses meson build system)
    if [ -n "$SPECIFIC_PLUGIN" ]; then
        log_highlight "Building only: $SPECIFIC_PLUGIN"
        # Meson doesn't support building single plugins easily, so build all
        meson setup build --buildtype=release --prefix="$INSTALL_DIR" -Dlv2dir="$INSTALL_DIR"
    else
        meson setup build --buildtype=release --prefix="$INSTALL_DIR" -Dlv2dir="$INSTALL_DIR"
    fi

    log_success "Build configured"
}

# Build Airwindows
build_airwindows() {
    print_header "Building Airwindows LV2 Plugins"

    cd "$BUILD_DIR/airwindows-lv2"

    log_info "Building with $JOBS parallel jobs..."

    # Use meson compile (ninja under the hood)
    meson compile -C build -j $JOBS

    log_success "Build completed"
}

# Install plugins
install_airwindows() {
    print_header "Installing Airwindows Plugins"

    cd "$BUILD_DIR/airwindows-lv2"

    # Create install directory
    mkdir -p "$INSTALL_DIR"

    log_info "Installing to $INSTALL_DIR..."

    # Use meson install to install all plugins
    # Airwindows LV2 installs as a single Airwindows.lv2 bundle with all plugins inside
    DESTDIR="" meson install -C build --no-rebuild

    # Check what was installed
    if [ -d "$INSTALL_DIR/Airwindows.lv2" ]; then
        log_success "Airwindows.lv2 bundle installed successfully"

        # Count plugin ttl files (excluding manifest.ttl)
        TTL_COUNT=$(ls "$INSTALL_DIR/Airwindows.lv2/"*.ttl 2>/dev/null | grep -v manifest.ttl | wc -l)
        log_info "Bundle contains $TTL_COUNT plugins"

        if [ -n "$SPECIFIC_PLUGIN" ]; then
            # Check if specific plugin exists
            PLUGIN_LOWER=$(echo "$SPECIFIC_PLUGIN" | tr '[:upper:]' '[:lower:]')
            if ls "$INSTALL_DIR/Airwindows.lv2/"*.ttl 2>/dev/null | grep -qi "$PLUGIN_LOWER"; then
                log_success "$SPECIFIC_PLUGIN found in Airwindows bundle"
            else
                log_warning "$SPECIFIC_PLUGIN not found - may use different naming"
                log_info "Available plugins containing 'glitch' or 'shift':"
                ls "$INSTALL_DIR/Airwindows.lv2/"*.ttl 2>/dev/null | grep -i "glitch\|shift" || echo "  (none found)"
            fi
        fi
    else
        log_error "Airwindows.lv2 bundle not found in $INSTALL_DIR"
    fi

    # Clear MAP2 plugin cache to trigger rescan
    if [ -f ~/.config/map2/plugin_cache.json ]; then
        log_info "Clearing MAP2 plugin cache..."
        rm -f ~/.config/map2/plugin_cache.json
    fi

    log_success "Installation complete"
}

# Verify build
verify_build() {
    print_header "Verifying Build"

    # Check installed plugins
    INSTALLED_COUNT=$(find "$INSTALL_DIR" -maxdepth 1 -type d -name "*.lv2" 2>/dev/null | wc -l)
    log_info "Installed $INSTALLED_COUNT LV2 plugin bundles to $INSTALL_DIR"

    # If installed, check with lv2ls
    if [ "$INSTALL_SYSTEM" = true ]; then
        if command -v lv2ls &>/dev/null; then
            if [ -n "$SPECIFIC_PLUGIN" ]; then
                INSTALLED=$(lv2ls 2>/dev/null | grep -ic "$SPECIFIC_PLUGIN" || echo "0")
                log_info "Found $INSTALLED matching plugins in LV2 registry"
            else
                AIRWINDOWS_COUNT=$(lv2ls 2>/dev/null | grep -ic "airwindows\|hannesbraun" || echo "0")
                log_info "System has $AIRWINDOWS_COUNT Airwindows plugins registered"
            fi
        fi

        # Show installed plugin
        if [ -n "$SPECIFIC_PLUGIN" ]; then
            log_info "Installed plugin:"
            ls -la "$INSTALL_DIR"/*[Gg]litch*[Ss]hifter*.lv2 2>/dev/null || ls -la "$INSTALL_DIR"/*.lv2 2>/dev/null | head -5
        fi
    fi

    log_success "Verification complete"
}

# Print summary
print_summary() {
    print_header "Build Summary"

    echo ""
    if [ -n "$SPECIFIC_PLUGIN" ]; then
        echo -e "${CYAN}Airwindows ${SPECIFIC_PLUGIN}${NC} has been built!"
    else
        echo -e "${CYAN}Airwindows LV2 Plugins${NC} have been built!"
    fi
    echo ""
    echo "Build directory: $BUILD_DIR/airwindows-lv2"
    echo ""

    if [ "$INSTALL_SYSTEM" = true ]; then
        echo "Plugins installed to: $INSTALL_DIR"
        echo ""
        echo "Next steps:"
        echo "  1. Restart MAP2 backend: sudo systemctl restart map2-backend"
        echo "  2. Refresh plugins in the web UI"
        echo ""

        # Show GlitchShifter specific info
        if [ "$SPECIFIC_PLUGIN" = "GlitchShifter" ]; then
            echo -e "${CYAN}GlitchShifter Plugin Info:${NC}"
            echo "  URI: https://hannesbraun.net/ns/lv2/airwindows/glitchshifter"
            echo "  Category: Harmonizer / Pitch Shifter"
            echo "  Description: Granular pitch shifter with glitchy artifacts"
            echo ""
            echo "  Parameters:"
            echo "    - Note: Pitch shift amount (-12 to +12 semitones)"
            echo "    - Trim: Fine tune adjustment"
            echo "    - Tightness: Grain tightness/quality"
            echo "    - Feedback: Delay/feedback amount"
            echo "    - Dry/Wet: Mix control"
            echo ""
        fi
    else
        echo "To install, run:"
        echo "  $0 --install"
        echo ""
        echo "Or for GlitchShifter only:"
        echo "  $0 --install --plugin GlitchShifter"
    fi
}

# Main build flow
main() {
    print_header "Airwindows LV2 Build Script"
    echo ""
    log_highlight "The legendary Airwindows plugin collection by Chris Johnson"
    log_highlight "LV2 port by Hannes Braun"
    echo ""
    echo "Build directory: $BUILD_DIR"
    echo "Install directory: $INSTALL_DIR"
    echo "Parallel jobs: $JOBS"
    echo "Install after build: $INSTALL_SYSTEM"
    if [ -n "$SPECIFIC_PLUGIN" ]; then
        echo "Specific plugin: $SPECIFIC_PLUGIN"
    fi
    echo ""

    install_dependencies
    prepare_source
    configure_build
    build_airwindows

    if [ "$INSTALL_SYSTEM" = true ]; then
        install_airwindows
    fi

    verify_build
    print_summary

    log_success "Build process complete!"
}

# Run main
main "$@"
