# T2521-8 — example environment fragment for the MAP2 SonoBus / AOO
# remote-audio transport daemon.
#
# Install path: /etc/map2/sonobus.env
# Loaded by systemd via the
# `EnvironmentFile=-/etc/map2/sonobus.env` directive in
# systemd/map2-sonobus-transport.service.
#
# All variables here are operator-overrides for the locked-decision
# defaults baked into the service unit. See
# docs/architecture/SONOBUS_AOO_TRANSPORT.md §0 for the locked Q1-Q21
# decisions.

# Q3 — MAP2 hosts its own AOO/SonoBus connection server by default.
# Set to 0 to disable (operator-driven, advanced).
#MAP2_SONOBUS_CONNECTION_SERVER=1

# Q14 — full multichannel from day one. The daemon caps per-binding
# channel_count at this value; the authority's Pydantic schema also
# rejects creates over the cap.
#MAP2_SONOBUS_MAX_CHANNELS=32

# Q18 — default per-binding transport priority. One of:
#   avb_preferred      (default — AVB wins if it can carry the intent)
#   sonobus_preferred  (SonoBus wins over AVB)
#   sonobus_only       (refuse AVB fallback for this binding)
#MAP2_SONOBUS_DEFAULT_TRANSPORT_PRIORITY=avb_preferred

# UDP port range used by the AOO source/sink runtime. Must match the
# firewalld service fragment at /etc/firewalld/services/map2-sonobus.xml.
#MAP2_SONOBUS_UDP_PORT_BASE=10000
#MAP2_SONOBUS_UDP_PORT_COUNT=100

# Q7/Q8 — default codec profile. v1 ships PCM 24-bit / 48 kHz; Opus
# slots are reserved for future expansion and currently rejected by
# the authority's Pydantic schema if set.
#MAP2_SONOBUS_DEFAULT_CODEC_PROFILE=pcm

# Q9 — default jitter buffer / resend posture. Operator-tunable per
# binding; this is the system default.
#MAP2_SONOBUS_DEFAULT_JITTER_BUFFER_MS=4
#MAP2_SONOBUS_DEFAULT_RESEND_POLICY=burst_loss_only

# Q19 — validation gates expect same-LAN testing with impairment.
# Set to 1 to enable verbose diagnostic logging for soak runs.
#MAP2_SONOBUS_DIAGNOSTICS_VERBOSE=0
