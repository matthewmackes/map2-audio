{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "map2://schemas/drums/drum_kit",
  "title": "MAP2 Drum Kit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kit_id",
    "name",
    "version",
    "category",
    "license",
    "default_bpm",
    "default_swing",
    "instruments"
  ],
  "properties": {
    "kit_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "category": {
      "type": "string",
      "enum": ["acoustic", "electronic", "percussion", "hybrid"]
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "default_bpm": {
      "type": "number",
      "minimum": 20,
      "maximum": 300
    },
    "default_swing": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "instruments": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sfz_path",
          "default_note",
          "bus_assignment",
          "default_volume",
          "default_pan",
          "default_tune"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sfz_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\.\\\\.)(?!.*//).+\\\\.sfz$"
          },
          "default_note": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "bus_assignment": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "default_volume": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "default_pan": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "default_tune": {
            "type": "number",
            "minimum": -24,
            "maximum": 24
          }
        }
      }
    }
  }
}
