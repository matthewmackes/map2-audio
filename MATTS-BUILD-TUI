#!/bin/bash
# ============================================================================
# MATTS-BUILD-TUI - MAP2 Audio Platform Build System Terminal UI
# Main entry point for development builds with comprehensive system state
# checks, build operations, and AI-friendly structured output
# ============================================================================

set -o pipefail

# ============================================================================
# CONFIGURATION
# ============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$SCRIPT_DIR"
HELPERS_DIR="$PROJECT_ROOT/scripts/build"
BUILD_DIR="$PROJECT_ROOT/build"
LOGS_DIR="$PROJECT_ROOT/logs"
LOCK_DIR="/tmp/map2-build-locks"
BUILD_LOG="$LOGS_DIR/build-$(date +%Y%m%d_%H%M%S).log"
STATE_FILE="$LOCK_DIR/build-state.json"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
NC='\033[0m'

# Export for subshells
export SCRIPT_DIR PROJECT_ROOT HELPERS_DIR BUILD_DIR LOGS_DIR
export LOCK_DIR BUILD_LOG STATE_FILE

# ============================================================================
# UTILITY FUNCTIONS
# ============================================================================

setup_environment() {
    mkdir -p "$LOGS_DIR" "$LOCK_DIR" "$BUILD_DIR" "$HELPERS_DIR"
    touch "$BUILD_LOG"
    chmod 755 "$HELPERS_DIR" 2>/dev/null || true
}

log_message() {
    local message="$1"
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    echo "[$timestamp] $message" >> "$BUILD_LOG"
    echo "$message"
}

print_header() {
    echo -e "\n${CYAN}╔════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${NC} $1"
    echo -e "${CYAN}╚════════════════════════════════════════════════════════════╝${NC}\n"
}

print_status() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[✓]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[⚠]${NC} $1"
}

print_error() {
    echo -e "${RED}[✗]${NC} $1"
}

check_executable() {
    if [ ! -x "$HELPERS_DIR/$1" ]; then
        print_error "Helper script missing or not executable: $1"
        return 1
    fi
    return 0
}

acquire_lock() {
    local lock_file="$LOCK_DIR/build-$(echo "$1" | tr '[:upper:]' '[:lower:]' | tr ' ' '-').lock"
    
    if [ -f "$lock_file" ]; then
        local pid=$(cat "$lock_file" 2>/dev/null)
        if kill -0 "$pid" 2>/dev/null; then
            return 1  # Lock is active
        else
            rm -f "$lock_file"  # Stale lock
        fi
    fi
    
    echo $$ > "$lock_file"
    echo "$lock_file"
    return 0
}

release_lock() {
    local lock_file="$1"
    [ -n "$lock_file" ] && rm -f "$lock_file" 2>/dev/null || true
}

get_system_state() {
    if check_executable "system-check"; then
        "$HELPERS_DIR/system-check" --json 2>/dev/null || echo "{}"
    else
        echo "{}"
    fi
}

save_build_state() {
    local operation="$1"
    local status="$2"
    local details="$3"
    
    cat > "$STATE_FILE" <<EOF
{
  "timestamp": "$(date -Iseconds)",
  "operation": "$operation",
  "status": "$status",
  "details": "$details",
  "user": "$(whoami)",
  "hostname": "$(hostname)",
  "pid": $$
}
EOF
}

# ============================================================================
# MENU FUNCTIONS
# ============================================================================

show_main_menu() {
    print_header "MAP2 BUILD SYSTEM - MAIN MENU"
    
    local state=$(get_system_state)
    
    echo -e "${CYAN}System Status:${NC}"
    echo "  Disk Space: $(echo "$state" | grep -o '"disk_usage":"[^"]*"' | cut -d'"' -f4 || echo 'N/A')"
    echo "  Memory: $(echo "$state" | grep -o '"memory_usage":"[^"]*"' | cut -d'"' -f4 || echo 'N/A')"
    echo "  Build Tools: $(echo "$state" | grep -o '"tools_ok":"[^"]*"' | cut -d'"' -f4 || echo 'N/A')"
    echo ""
    
    echo -e "${GREEN}Available Operations:${NC}"
    echo "  1) Build Production Web (port 3000)"
    echo "  2) Build Development Web (port 3001)"
    echo "  3) Recompile JUCE Plugins"
    echo "  4) Clean Build Artifacts"
    echo "  5) Check System State (detailed)"
    echo "  6) View Recent Logs"
    echo "  7) View Build Configuration"
    echo "  8) Advanced Options"
    echo "  0) Exit"
    echo ""
    echo -e "${YELLOW}Status: Ready${NC}"
    echo ""
}

menu_build_production() {
    print_header "BUILD PRODUCTION WEB (PORT 3000)"
    
    local lock=$(acquire_lock "Production Build")
    if [ $? -ne 0 ]; then
        print_warning "A build is already in progress. Wait for it to complete."
        return 1
    fi
    
    save_build_state "production_build" "in_progress" "Port 3000"
    
    print_status "Starting production build..."
    log_message "Beginning production web build"
    
    if check_executable "build-web-prod"; then
        if "$HELPERS_DIR/build-web-prod" 3000 2>&1 | tee -a "$BUILD_LOG"; then
            print_success "Production build completed successfully!"
            save_build_state "production_build" "success" "Ready on port 3000"
            release_lock "$lock"
            return 0
        else
            print_error "Production build failed. Check logs: $BUILD_LOG"
            save_build_state "production_build" "failed" "See logs for details"
            release_lock "$lock"
            return 1
        fi
    else
        print_error "build-web-prod helper not found"
        release_lock "$lock"
        return 1
    fi
}

menu_build_development() {
    print_header "BUILD DEVELOPMENT WEB (PORT 3001)"
    
    local lock=$(acquire_lock "Development Build")
    if [ $? -ne 0 ]; then
        print_warning "A build is already in progress. Wait for it to complete."
        return 1
    fi
    
    save_build_state "dev_build" "in_progress" "Port 3001"
    
    print_status "Starting development build with hot-reload..."
    log_message "Beginning development web build"
    
    if check_executable "build-web-dev"; then
        if "$HELPERS_DIR/build-web-dev" 3001 2>&1 | tee -a "$BUILD_LOG"; then
            print_success "Development build started successfully!"
            save_build_state "dev_build" "success" "Running on port 3001"
            release_lock "$lock"
            return 0
        else
            print_error "Development build failed. Check logs: $BUILD_LOG"
            save_build_state "dev_build" "failed" "See logs for details"
            release_lock "$lock"
            return 1
        fi
    else
        print_error "build-web-dev helper not found"
        release_lock "$lock"
        return 1
    fi
}

menu_recompile_juce() {
    print_header "RECOMPILE JUCE PLUGINS"
    
    local lock=$(acquire_lock "JUCE Compilation")
    if [ $? -ne 0 ]; then
        print_warning "A build is already in progress. Wait for it to complete."
        return 1
    fi
    
    save_build_state "juce_compile" "in_progress" "Compiling JUCE plugins"
    
    print_status "Starting JUCE plugin recompilation..."
    log_message "Beginning JUCE plugin compilation"
    
    if check_executable "build-juce"; then
        if "$HELPERS_DIR/build-juce" 2>&1 | tee -a "$BUILD_LOG"; then
            print_success "JUCE compilation completed successfully!"
            save_build_state "juce_compile" "success" "Plugins ready"
            release_lock "$lock"
            return 0
        else
            print_error "JUCE compilation failed. Check logs: $BUILD_LOG"
            save_build_state "juce_compile" "failed" "See logs for details"
            release_lock "$lock"
            return 1
        fi
    else
        print_error "build-juce helper not found"
        release_lock "$lock"
        return 1
    fi
}

menu_clean_build() {
    print_header "CLEAN BUILD ARTIFACTS"
    
    print_warning "This will remove build artifacts. Continue? (y/N)"
    read -r response
    
    if [[ ! "$response" =~ ^[Yy]$ ]]; then
        print_status "Clean cancelled."
        return 0
    fi
    
    local lock=$(acquire_lock "Clean Build")
    if [ $? -ne 0 ]; then
        print_warning "A build is already in progress. Wait for it to complete."
        return 1
    fi
    
    save_build_state "clean" "in_progress" "Removing artifacts"
    
    print_status "Cleaning build artifacts..."
    log_message "Starting clean build"
    
    if check_executable "clean-build"; then
        if "$HELPERS_DIR/clean-build" 2>&1 | tee -a "$BUILD_LOG"; then
            print_success "Clean completed successfully!"
            save_build_state "clean" "success" "Artifacts removed"
            release_lock "$lock"
            return 0
        else
            print_error "Clean operation encountered issues. Check logs: $BUILD_LOG"
            save_build_state "clean" "failed" "See logs for details"
            release_lock "$lock"
            return 1
        fi
    else
        print_error "clean-build helper not found"
        release_lock "$lock"
        return 1
    fi
}

menu_check_system() {
    print_header "DETAILED SYSTEM STATE CHECK"
    
    log_message "Running detailed system check"
    
    if check_executable "system-check"; then
        if "$HELPERS_DIR/system-check" --detailed 2>&1 | tee -a "$BUILD_LOG"; then
            print_success "System check completed."
            return 0
        else
            print_error "System check failed. Check logs: $BUILD_LOG"
            return 1
        fi
    else
        print_error "system-check helper not found"
        return 1
    fi
}

menu_view_logs() {
    print_header "VIEW RECENT LOGS"
    
    if [ ! -f "$BUILD_LOG" ]; then
        print_warning "No build logs found yet."
        return 0
    fi
    
    echo -e "${CYAN}Last 50 lines of build log:${NC}\n"
    tail -50 "$BUILD_LOG"
    echo ""
}

menu_view_config() {
    print_header "BUILD CONFIGURATION"
    
    cat <<EOF
${CYAN}MAP2 Build System Configuration${NC}

Project Root:    $PROJECT_ROOT
Build Directory: $BUILD_DIR
Logs Directory:  $LOGS_DIR
Helpers Dir:     $HELPERS_DIR
Lock Dir:        $LOCK_DIR
Current Log:     $BUILD_LOG

${CYAN}Ports Configuration${NC}
Production Web:  3000
Development Web: 3001

${CYAN}Build Information${NC}
Version:         3.0.0-FEB2026
Platform:        $(uname -s)
Architecture:    $(uname -m)
Timestamp:       $(date)

EOF
}

menu_advanced() {
    print_header "ADVANCED OPTIONS"
    
    echo -e "${GREEN}Advanced Operations:${NC}"
    echo "  1) Export build state (JSON)"
    echo "  2) View lock files"
    echo "  3) Force unlock all builds"
    echo "  4) Check for reboot requirement"
    echo "  0) Back to main menu"
    echo ""
    
    read -p "Select option: " choice
    
    case "$choice" in
        1) menu_export_state ;;
        2) menu_view_locks ;;
        3) menu_force_unlock ;;
        4) menu_check_reboot ;;
        0) return 0 ;;
        *) print_error "Invalid option" ;;
    esac
}

menu_export_state() {
    print_header "EXPORT BUILD STATE (JSON)"
    
    if [ -f "$STATE_FILE" ]; then
        cat "$STATE_FILE"
    else
        echo "{\"status\": \"no_state_recorded\"}"
    fi
    echo ""
}

menu_view_locks() {
    print_header "ACTIVE LOCK FILES"
    
    if [ -d "$LOCK_DIR" ] && [ -n "$(ls -A "$LOCK_DIR" 2>/dev/null)" ]; then
        echo -e "${CYAN}Active locks:${NC}"
        for lock in "$LOCK_DIR"/*.lock; do
            if [ -f "$lock" ]; then
                local pid=$(cat "$lock" 2>/dev/null)
                if kill -0 "$pid" 2>/dev/null; then
                    echo "  $(basename "$lock"): PID $pid (active)"
                else
                    echo "  $(basename "$lock"): PID $pid (stale)"
                fi
            fi
        done
    else
        print_status "No active locks."
    fi
    echo ""
}

menu_force_unlock() {
    print_header "FORCE UNLOCK ALL BUILDS"
    
    print_warning "Force unlocking may interrupt ongoing builds. Continue? (y/N)"
    read -r response
    
    if [[ ! "$response" =~ ^[Yy]$ ]]; then
        print_status "Force unlock cancelled."
        return 0
    fi
    
    rm -f "$LOCK_DIR"/*.lock
    print_success "All locks removed."
    log_message "Force unlocked all builds"
    echo ""
}

menu_check_reboot() {
    print_header "REBOOT REQUIREMENT CHECK"
    
    local reboot_needed=0
    
    # Check for kernel updates
    if [ -f /var/run/reboot-required ]; then
        print_warning "System reboot required (kernel or critical updates)"
        reboot_needed=1
    fi
    
    # Check for systemd restart
    if systemctl is-system-running --quiet 2>&1 | grep -q degraded; then
        print_warning "Some systemd units are degraded"
        reboot_needed=1
    fi
    
    if [ $reboot_needed -eq 0 ]; then
        print_success "No immediate reboot required."
    fi
    
    echo ""
}

# ============================================================================
# MAIN LOOP
# ============================================================================

main_loop() {
    while true; do
        show_main_menu
        read -p "Select option: " choice
        
        case "$choice" in
            1) menu_build_production && { echo ""; read -p "Press Enter to continue..."; } ;;
            2) menu_build_development && { echo ""; read -p "Press Enter to continue..."; } ;;
            3) menu_recompile_juce && { echo ""; read -p "Press Enter to continue..."; } ;;
            4) menu_clean_build && { echo ""; read -p "Press Enter to continue..."; } ;;
            5) menu_check_system && { echo ""; read -p "Press Enter to continue..."; } ;;
            6) menu_view_logs && { echo ""; read -p "Press Enter to continue..."; } ;;
            7) menu_view_config && { echo ""; read -p "Press Enter to continue..."; } ;;
            8) menu_advanced && { echo ""; read -p "Press Enter to continue..."; } ;;
            0) 
                echo -e "\n${GREEN}Goodbye!${NC}\n"
                exit 0
                ;;
            *)
                print_error "Invalid option. Please try again."
                read -p "Press Enter to continue..."
                ;;
        esac
        
        clear
    done
}

# ============================================================================
# ENTRY POINT
# ============================================================================

main() {
    setup_environment
    
    # Handle command-line arguments
    case "${1:-}" in
        --help|-h)
            cat <<EOF
MATTS-BUILD-TUI - MAP2 Build System Terminal UI

Usage: MATTS-BUILD-TUI [OPTION]

Options:
  --help, -h          Show this help message
  --status            Show current build status (JSON)
  --log               Show recent build log
  --state             Show build state file
  --interactive, -i   Start interactive menu (default)

Examples:
  MATTS-BUILD-TUI               # Start interactive menu
  MATTS-BUILD-TUI --status      # Show JSON status
  MATTS-BUILD-TUI --log         # View recent logs

EOF
            exit 0
            ;;
        --status)
            get_system_state | jq . 2>/dev/null || get_system_state
            exit 0
            ;;
        --log)
            [ -f "$BUILD_LOG" ] && tail -100 "$BUILD_LOG" || echo "No logs available"
            exit 0
            ;;
        --state)
            [ -f "$STATE_FILE" ] && cat "$STATE_FILE" || echo "No state recorded"
            exit 0
            ;;
        --interactive|-i|"")
            clear
            main_loop
            ;;
        *)
            print_error "Unknown option: $1"
            exit 1
            ;;
    esac
}

main "$@"
