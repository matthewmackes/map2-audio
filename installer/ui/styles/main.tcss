/*
 * installer/ui/styles/main.tcss
 * ==============================
 * Global Textual CSS for the MAP2 Enterprise Installer.
 *
 * Design goals:
 *   1. Professional, Anaconda-inspired look: dark background with accent colours.
 *   2. TrueColor palette with graceful 256-color and 16-color fallbacks
 *      (Textual handles terminal capability detection automatically).
 *   3. Consistent spacing and typography across all stage screens.
 *   4. Monochrome-friendly: all visual distinctions are also expressed through
 *      characters/symbols, not colour alone (accessible on serial consoles).
 *
 * Variables defined here override Textual's built-in theme defaults.
 * The $accent, $primary, $success, $warning, $error variables are resolved
 * by Textual at render time based on the terminal's colour depth.
 */

/* ── Global screen defaults ─────────────────────────────────────────────── */
Screen {
    background: $surface;
    color: $text;
}

Header {
    /* Anaconda-style header: bold product name, dark background */
    background: $primary-darken-2;
    color: $primary-lighten-3;
    text-style: bold;
    height: 2;
}

Footer {
    /* Anaconda-style footer key hint bar */
    background: $primary-darken-3;
    color: $text-muted;
    height: 1;
}

/* ── Layout containers ──────────────────────────────────────────────────── */
ScrollableContainer {
    overflow-y: auto;
}

/* ── Typography ─────────────────────────────────────────────────────────── */
Label {
    margin: 0;
    padding: 0;
}

Static {
    margin: 0;
    padding: 0;
}

Rule {
    margin: 1 4;
    color: $primary-darken-1;
}

/* ── Interactive widgets ────────────────────────────────────────────────── */
Input {
    border: round $primary;
    background: $surface-darken-1;
    color: $text;
    padding: 0 1;
    margin-bottom: 1;
}

Input:focus {
    border: round $accent;
    background: $surface;
}

Button {
    margin: 0 1;
    min-width: 16;
}

Button:focus {
    border: tall $accent;
}

RadioSet {
    background: transparent;
    border: none;
    padding: 0;
}

RadioButton {
    color: $text;
    margin: 0 0 0 0;
}

RadioButton:focus {
    color: $accent;
}

Checkbox {
    color: $text;
    margin: 0 0 1 0;
}

Checkbox:focus {
    color: $accent;
}

ProgressBar {
    width: 1fr;
}

ProgressBar > .bar--bar {
    color: $accent;
}

ProgressBar > .bar--complete {
    color: $success;
}

/* ── Rich log widget ────────────────────────────────────────────────────── */
RichLog {
    background: $surface-darken-2;
    color: $text;
    border: round $primary-darken-1;
    scrollbar-size: 1 1;
}

/* ── Select widget ──────────────────────────────────────────────────────── */
Select {
    border: round $primary;
    background: $surface-darken-1;
    margin-bottom: 1;
}

Select:focus {
    border: round $accent;
}

/* ── LoadingIndicator ───────────────────────────────────────────────────── */
LoadingIndicator {
    color: $accent;
}

/* ── Markdown (used in HelpOverlay) ────────────────────────────────────── */
Markdown {
    background: $surface;
    color: $text;
    padding: 1;
}

Markdown > .markdown-h1 {
    color: $accent;
    text-style: bold;
    border-bottom: solid $primary;
}

Markdown > .markdown-h2 {
    color: $primary;
    text-style: bold;
}

/* ── Utility classes used across screens ────────────────────────────────── */
.text-success { color: $success; }
.text-warning { color: $warning; }
.text-error   { color: $error;   }
.text-accent  { color: $accent;  }
.text-muted   { color: $text-muted; }
.text-bold    { text-style: bold; }
.text-center  { text-align: center; }

/* ── Modal dialogs ──────────────────────────────────────────────────────── */
ModalScreen {
    background: rgba(0, 0, 0, 0.8);
}
