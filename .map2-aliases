#!/bin/bash
###############################################################################
# MAP2 Audio Platform - Shell Aliases & Quick Commands
# Modern unified interface for MAP2 operations
###############################################################################

# === NEW UNIFIED COMMANDS (Recommended) ===
# Master control script
alias map2-start='/home/mm/map2-audio/map2.sh start'
alias map2-stop='/home/mm/map2-audio/map2.sh stop'
alias map2-restart='/home/mm/map2-audio/map2.sh restart'
alias map2-status='/home/mm/map2-audio/map2.sh status'
alias map2-tui='/home/mm/map2-audio/map2.sh tui'
alias map2-dev-on='/home/mm/map2-audio/map2.sh dev on'
alias map2-dev-off='/home/mm/map2-audio/map2.sh dev off'
alias map2-dev-toggle='/home/mm/map2-audio/map2.sh dev toggle'

# Quick shortcuts  
alias m2='/home/mm/map2-audio/m2.sh'
alias m2-start='/home/mm/map2-audio/m2.sh start'
alias m2-restart='/home/mm/map2-audio/m2.sh restart'
alias m2-dev='/home/mm/map2-audio/m2.sh dev'
alias m2-stage='/home/mm/map2-audio/m2.sh stage'
alias m2-status='/home/mm/map2-audio/m2.sh status'

# Mode management (the proper way to switch modes)
alias map2-mode='/home/mm/map2-audio/scripts/map2-mode.sh'
alias m2-mode='/home/mm/map2-audio/scripts/map2-mode.sh'

# Navigation shortcuts
alias map2='cd /home/mm/map2-audio'
alias map2-web='cd /home/mm/map2-audio/web'
alias map2-app='cd /home/mm/map2-audio/app'
alias map2-juce='cd /home/mm/map2-audio/juce-engine'
alias map2-tui-dir='cd /home/mm/map2-audio/tui'

# === LEGACY ALIASES (Deprecated but kept for compatibility) ===
# Use map2.sh or m2.sh instead for better functionality
alias server-restart='echo "⚠️  Use: ./m2.sh restart (recommended)" && /home/mm/map2-audio/m2.sh restart'
alias server-status='echo "⚠️  Use: ./m2.sh status (recommended)" && /home/mm/map2-audio/m2.sh status'
alias api-status='curl -s http://localhost:8080/api/health || echo "API not responding"'

###############################################################################
# Quick Start Guide:
#
# 🚀 FASTEST COMMANDS:
#   m2-start           # Start all MAP2 services
#   m2-dev             # Switch to development mode
#   m2-stage           # Switch to stage mode  
#   m2-status          # Check system status
#   m2-restart         # Restart everything
#
# 🎛️ FULL CONTROL:
#   ./map2.sh start    # Start services with detailed output
#   ./map2.sh dev on   # Enable development mode
#   ./map2.sh tui      # Launch Terminal Interface
#   ./map2.sh help     # See all available commands
#
# 🌐 WEB ACCESS:
#   Frontend:  http://localhost:3000
#   Backend:   http://localhost:8080  
#   API Docs:  http://localhost:8080/docs
#
# 📁 NAVIGATION:
#   map2               # Go to project root
#   map2-web           # Go to web directory
#   map2-juce          # Go to JUCE engine
#
# Installation (if not already done):
#   echo 'source /home/mm/map2-audio/.map2-aliases' >> ~/.bashrc
#   source ~/.bashrc
###############################################################################
